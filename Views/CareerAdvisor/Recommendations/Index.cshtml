@model List<ResourceReach>
@{
    ViewData["Title"] = "Recommendations";
}

<div class="bg-white rounded-4 shadow-sm p-3 mb-4">
    <h4 class="mb-1">Automatic Recommendations</h4>
    <p class="text-muted mb-0">
        Job seekers are matched to your published resources automatically, based on their preferred job
        category, field of study, and the skills required by jobs they've applied to. Tag a resource with
        <a asp-controller="CareerResources" asp-action="Index">Related Category / Related Skills</a> to reach more job seekers.
    </p>
</div>

@if (!Model.Any())
{
    <div class="alert alert-light border text-center text-muted rounded-4">
        You don't have any published resources yet. <a asp-controller="CareerResources" asp-action="Create">Publish one</a> to start reaching job seekers.
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var reach in Model)
        {
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis mb-1">@reach.Resource.ResourceType</span>
                            <h5 class="mb-0">@reach.Resource.Title</h5>
                        </div>
                        <span class="badge rounded-pill @(reach.MatchedJobSeekers.Any() ? "bg-success-subtle text-success-emphasis" : "bg-secondary-subtle text-secondary-emphasis") px-3 py-2">
                            @reach.MatchedJobSeekers.Count matched
                        </span>
                    </div>

                    @if (string.IsNullOrWhiteSpace(reach.Resource.RelatedCategory) && string.IsNullOrWhiteSpace(reach.Resource.RelatedSkill))
                    {
                        <div class="alert alert-warning py-2 px-3 small mb-3">
                            This resource has no matching tags, so it won't be recommended to anyone.
                            <a asp-controller="CareerResources" asp-action="Edit" asp-route-id="@reach.Resource.CareerResourceId">Add tags</a>.
                        </div>
                    }

                    @if (!reach.MatchedJobSeekers.Any())
                    {
                        <p class="text-muted small mb-0">No job seekers match this resource yet.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>Job Seeker</th>
                                        <th>Matched Because</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var match in reach.MatchedJobSeekers)
                                    {
                                        <tr>
                                            <td>@match.FullName</td>
                                            <td>
                                                @foreach (var reason in match.Reasons)
                                                {
                                                    <div class="small text-muted">@reason</div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
