@{
    ViewData["Title"] = "Career Advisor Dashboard";
}

<div class="ca-welcome-card">
    <h4><i class="bi bi-mortarboard-fill me-2"></i>Welcome back, Career Advisor</h4>
    <p>Publish guidance resources, review job seekers' progress, and manage counselling sessions from here.</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="ca-stat-card card">
            <div class="card-body">
                <div class="ca-stat-icon"><i class="bi bi-journal-check"></i></div>
                <div>
                    <div class="ca-stat-value">@ViewBag.PublishedResourceCount</div>
                    <div class="ca-stat-label">Published Resources</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="ca-stat-card card">
            <div class="card-body">
                <div class="ca-stat-icon amber"><i class="bi bi-pencil-square"></i></div>
                <div>
                    <div class="ca-stat-value">@ViewBag.DraftResourceCount</div>
                    <div class="ca-stat-label">Draft Resources</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="ca-stat-card card">
            <div class="card-body">
                <div class="ca-stat-icon violet"><i class="bi bi-stars"></i></div>
                <div>
                    <div class="ca-stat-value">@ViewBag.AutoMatchCount</div>
                    <div class="ca-stat-label">Auto-Matched to Job Seekers</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="ca-stat-card card">
            <div class="card-body">
                <div class="ca-stat-icon blue"><i class="bi bi-calendar2-week"></i></div>
                <div>
                    <div class="ca-stat-value">@ViewBag.UpcomingSessionCount</div>
                    <div class="ca-stat-label">Upcoming Sessions</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="ca-stat-card card">
            <div class="card-body">
                <div class="ca-stat-icon amber"><i class="bi bi-hourglass-split"></i></div>
                <div>
                    <div class="ca-stat-value">@ViewBag.PendingSessionCount</div>
                    <div class="ca-stat-label">Pending Session Requests</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="ca-stat-card card">
            <div class="card-body">
                <div class="ca-stat-icon"><i class="bi bi-clipboard-check"></i></div>
                <div>
                    <div class="ca-stat-value">@ViewBag.AssessmentCount</div>
                    <div class="ca-stat-label">Skill Assessments</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
        <h5 class="mb-3"><i class="bi bi-lightning-charge me-1"></i> Quick Actions</h5>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="CareerResources" asp-action="Create" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-plus-lg me-1"></i>Publish a Resource
            </a>
            <a asp-controller="JobSeekerReview" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">
                <i class="bi bi-people me-1"></i>Review Job Seekers (@ViewBag.JobSeekerCount)
            </a>
            <a asp-controller="CounsellingSessions" asp-action="Index" asp-route-tab="Pending" class="btn btn-outline-primary rounded-pill px-4">
                <i class="bi bi-hourglass-split me-1"></i>Review Session Requests (@ViewBag.PendingSessionCount)
            </a>
            <a asp-controller="SkillAssessments" asp-action="Create" class="btn btn-outline-primary rounded-pill px-4">
                <i class="bi bi-clipboard-plus me-1"></i>Create an Assessment
            </a>
        </div>
    </div>
</div>
