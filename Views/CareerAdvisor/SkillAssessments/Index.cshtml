@model List<SkillAssessment>
@{
    ViewData["Title"] = "Skill Assessments";
    var questionCounts = (Dictionary<int, int>)ViewBag.QuestionCounts;
    var attemptCounts = (Dictionary<int, int>)ViewBag.AttemptCounts;
}

<div class="d-flex justify-content-between align-items-center bg-white rounded-4 shadow-sm p-3 mb-4">
    <h4 class="mb-0">Skill Assessments</h4>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-4">+ Create Assessment</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-light border text-center text-muted rounded-4">
        You haven't created any skill assessments yet.
    </div>
}
else
{
    <div class="card border-0 rounded-4 shadow-sm">
        <div class="card-body p-0">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3">Title</th>
                        <th>Skill</th>
                        <th>Passing Score</th>
                        <th>Duration</th>
                        <th>Questions</th>
                        <th>Attempts</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var assessment in Model)
                    {
                        int questionCount = questionCounts.GetValueOrDefault(assessment.SkillAssessmentId, 0);
                        int attemptCount = attemptCounts.GetValueOrDefault(assessment.SkillAssessmentId, 0);
                        <tr>
                            <td class="ps-3">@assessment.Title</td>
                            <td><span class="badge rounded-pill bg-primary-subtle text-primary-emphasis">@assessment.SkillName</span></td>
                            <td>@assessment.PassingScore%</td>
                            <td>@assessment.DurationMinutes min</td>
                            <td>
                                @if (questionCount == 0)
                                {
                                    <span class="text-danger small">No questions yet</span>
                                }
                                else
                                {
                                    @questionCount
                                }
                            </td>
                            <td>@attemptCount</td>
                            <td>
                                @if (assessment.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis">Inactive</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <a asp-action="Questions" asp-route-id="@assessment.SkillAssessmentId" class="btn btn-outline-primary btn-sm rounded-pill">Questions</a>
                                <a asp-action="Edit" asp-route-id="@assessment.SkillAssessmentId" class="btn btn-outline-secondary btn-sm rounded-pill">Edit</a>
                                <form asp-action="Delete" asp-route-id="@assessment.SkillAssessmentId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill" onclick="return confirm('Delete this assessment?');">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
