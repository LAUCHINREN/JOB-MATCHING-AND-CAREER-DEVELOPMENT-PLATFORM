@model SkillAssessmentInput
@{
    ViewData["Title"] = "Create Skill Assessment";
}

<div class="card border-0 rounded-4 shadow-sm">
    <div class="card-body p-4">
        <h4 class="mb-4">Create a Skill Assessment</h4>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Title</label>
                <input asp-for="Title" class="form-control" placeholder="e.g. JavaScript Fundamentals" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SkillName" class="form-label"></label>
                <input asp-for="SkillName" class="form-control" placeholder="e.g. JavaScript" />
                <span asp-validation-for="SkillName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description (optional)</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="PassingScore" class="form-label"></label>
                    <input asp-for="PassingScore" class="form-control" type="number" min="0" max="100" />
                    <span asp-validation-for="PassingScore" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="DurationMinutes" class="form-label"></label>
                    <input asp-for="DurationMinutes" class="form-control" type="number" min="1" max="120" />
                    <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-check mb-4">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill px-4">Save &amp; Add Questions</button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
