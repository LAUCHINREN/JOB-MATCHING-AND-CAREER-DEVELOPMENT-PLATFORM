@model AssessmentQuestionInput
@{
    var assessment = (SkillAssessment)ViewBag.Assessment;
    ViewData["Title"] = "Edit Question";
}

<div class="card border-0 rounded-4 shadow-sm">
    <div class="card-body p-4">
        <h4 class="mb-1">Edit Question</h4>
        <p class="text-muted mb-4">@assessment.Title</p>

        <form asp-action="EditQuestion" asp-route-id="@Model.AssessmentQuestionId" method="post">
            <input type="hidden" asp-for="AssessmentQuestionId" />
            <input type="hidden" asp-for="SkillAssessmentId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="QuestionText" class="form-label"></label>
                <textarea asp-for="QuestionText" class="form-control" rows="2"></textarea>
                <span asp-validation-for="QuestionText" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="OptionA" class="form-label">Option A</label>
                    <input asp-for="OptionA" class="form-control" />
                    <span asp-validation-for="OptionA" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="OptionB" class="form-label">Option B</label>
                    <input asp-for="OptionB" class="form-control" />
                    <span asp-validation-for="OptionB" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="OptionC" class="form-label">Option C</label>
                    <input asp-for="OptionC" class="form-control" />
                    <span asp-validation-for="OptionC" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="OptionD" class="form-label">Option D</label>
                    <input asp-for="OptionD" class="form-control" />
                    <span asp-validation-for="OptionD" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-4" style="max-width:220px;">
                <label asp-for="CorrectAnswer" class="form-label"></label>
                <select asp-for="CorrectAnswer" class="form-select">
                    <option value="A">A</option>
                    <option value="B">B</option>
                    <option value="C">C</option>
                    <option value="D">D</option>
                </select>
                <span asp-validation-for="CorrectAnswer" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill px-4">Save Changes</button>
                <a asp-action="Questions" asp-route-id="@assessment.SkillAssessmentId" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
