@model List<CounsellingSession>
@{
    ViewData["Title"] = "Counselling Sessions";
    var profiles = (Dictionary<string, JobSeekerProfile>)ViewBag.Profiles;
    var names = (Dictionary<string, string>)ViewBag.Names;
    string currentTab = ViewBag.CurrentTab;
}

<div class="bg-white rounded-4 shadow-sm p-3 mb-4">
    <h4 class="mb-1">Counselling Sessions</h4>
    <p class="text-muted mb-0 small">
        Job seekers apply for a session themselves — approve or reject requests below. No sessions are created by advisors directly.
    </p>
</div>

<ul class="nav nav-pills mb-3">
    <li class="nav-item">
        <a class="nav-link rounded-pill @(currentTab == "Pending" ? "active" : "")" asp-action="Index" asp-route-tab="Pending">Pending Requests</a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill @(currentTab == "Approved" ? "active" : "")" asp-action="Index" asp-route-tab="Approved">Approved</a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill @(currentTab == "Completed" ? "active" : "")" asp-action="Index" asp-route-tab="Completed">Completed</a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill @(currentTab == "Rejected" ? "active" : "")" asp-action="Index" asp-route-tab="Rejected">Rejected</a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill @(currentTab == "Cancelled" ? "active" : "")" asp-action="Index" asp-route-tab="Cancelled">Cancelled</a>
    </li>
</ul>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-light border text-center text-muted rounded-4">
        @(currentTab == "Pending" ? "No pending session requests right now." : $"No {currentTab.ToLower()} sessions.")
    </div>
}
else
{
    <div class="card border-0 rounded-4 shadow-sm">
        <div class="card-body p-0">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3">Job Seeker</th>
                        <th>Requested / Scheduled At</th>
                        <th>Duration</th>
                        <th>Reason</th>
                        @if (currentTab == "Rejected")
                        {
                            <th>Rejection Reason</th>
                        }
                        @if (currentTab == "Approved" || currentTab == "Completed")
                        {
                            <th>Meeting Link</th>
                        }
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in Model)
                    {
                        profiles.TryGetValue(session.JobSeekerUserId, out var profile);
                        names.TryGetValue(session.JobSeekerUserId, out var fallbackName);
                        <tr>
                            <td class="ps-3">@(profile?.FullName ?? fallbackName ?? session.JobSeekerUserId)</td>
                            <td>@session.ScheduledAt.ToString("d MMM yyyy, h:mm tt")</td>
                            <td>@session.DurationMinutes min</td>
                            <td style="max-width:260px;">@(session.Notes ?? "-")</td>
                            @if (currentTab == "Rejected")
                            {
                                <td style="max-width:220px;">@(session.RejectionNote ?? "-")</td>
                            }
                            @if (currentTab == "Approved" || currentTab == "Completed")
                            {
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(session.MeetingLink))
                                    {
                                        <a href="@session.MeetingLink" target="_blank" rel="noopener noreferrer">
                                            <i class="bi bi-camera-video me-1"></i>Join
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            }
                            <td class="text-end pe-3">
                                @if (currentTab == "Pending")
                                {
                                    <button type="button" class="btn btn-outline-success btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#approveModal-@session.CounsellingSessionId">
                                        Approve
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#rejectModal-@session.CounsellingSessionId">
                                        Reject
                                    </button>
                                }
                                else if (currentTab == "Approved")
                                {
                                    <a asp-action="Edit" asp-route-id="@session.CounsellingSessionId" class="btn btn-outline-secondary btn-sm rounded-pill">Edit</a>
                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@session.CounsellingSessionId" />
                                        <input type="hidden" name="newStatus" value="Completed" />
                                        <button type="submit" class="btn btn-outline-success btn-sm rounded-pill">Mark Completed</button>
                                    </form>
                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@session.CounsellingSessionId" />
                                        <input type="hidden" name="newStatus" value="Cancelled" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill" onclick="return confirm('Cancel this session?');">Cancel</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (currentTab == "Pending")
{
    @foreach (var session in Model)
    {
        <div class="modal fade" id="approveModal-@session.CounsellingSessionId" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <form asp-action="Approve" asp-route-id="@session.CounsellingSessionId" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-content rounded-4">
                        <div class="modal-header">
                            <h5 class="modal-title">Approve session request</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <label class="form-label">Online meeting link</label>
                            <input type="url" name="meetingLink" class="form-control" maxlength="500" placeholder="https://meet.google.com/xyz" required />
                            <div class="form-text">The job seeker will use this link to join the session. Required before approving.</div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-success">Confirm Approve</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="modal fade" id="rejectModal-@session.CounsellingSessionId" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <form asp-action="Reject" asp-route-id="@session.CounsellingSessionId" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-content rounded-4">
                        <div class="modal-header">
                            <h5 class="modal-title">Reject session request</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <label class="form-label">Reason for rejection</label>
                            <textarea name="rejectionNote" class="form-control" rows="3" maxlength="500" required></textarea>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger">Confirm Reject</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }
}
