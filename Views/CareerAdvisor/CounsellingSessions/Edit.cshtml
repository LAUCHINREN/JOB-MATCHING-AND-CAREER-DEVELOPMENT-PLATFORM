@model CounsellingSessionInput
@{
    ViewData["Title"] = "Edit Counselling Session";
}

<div class="card border-0 rounded-4 shadow-sm">
    <div class="card-body p-4">
        <h4 class="mb-4">Edit Counselling Session</h4>

        <form asp-action="Edit" asp-route-id="@Model.CounsellingSessionId" method="post">
            <input type="hidden" asp-for="CounsellingSessionId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="ScheduledAt" class="form-label">Date &amp; Time</label>
                    <input asp-for="ScheduledAt" class="form-control" type="datetime-local" />
                    <span asp-validation-for="ScheduledAt" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="DurationMinutes" class="form-label">Duration (minutes)</label>
                    <input asp-for="DurationMinutes" class="form-control" type="number" min="15" max="240" />
                    <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="MeetingLink" class="form-label"></label>
                <input asp-for="MeetingLink" class="form-control" type="url" placeholder="https://meet.google.com/xyz" />
                <span asp-validation-for="MeetingLink" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Notes" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill px-4">Save Changes</button>
                <a asp-action="Index" asp-route-tab="Approved" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
