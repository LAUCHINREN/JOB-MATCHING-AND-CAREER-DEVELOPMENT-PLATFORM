@model JobSeekerAssessmentDetailViewModel
@{
    ViewData["Title"] = "Job Seeker Assessment History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0">@Model.FullName</h4>
        <span class="text-muted">@Model.Email</span>
        @if (!string.IsNullOrWhiteSpace(Model.Profile?.PreferredJobCategory))
        {
            <span class="badge bg-primary-subtle text-primary-emphasis ms-2">@Model.Profile!.PreferredJobCategory</span>
        }
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Back</a>
    </div>
</div>

@if (!Model.Attempts.Any())
{
    <div class="alert alert-light border text-center text-muted rounded-4">This job seeker has not attempted any assessments yet.</div>
}
else
{
    <div class="card border-0 rounded-4 shadow-sm">
        <div class="card-body p-0">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3">Assessment</th>
                        <th>Skill</th>
                        <th>Score</th>
                        <th>Result</th>
                        <th>Completed</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var attempt in Model.Attempts)
                    {
                        <tr>
                            <td class="ps-3">@attempt.AssessmentTitle</td>
                            <td>@attempt.SkillName</td>
                            <td>@attempt.Score</td>
                            <td>
                                @if (attempt.IsPassed)
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis">Passed</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger-emphasis">Failed</span>
                                }
                            </td>
                            <td>@attempt.CompletedDate.ToString("d MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@{
    var matchedResources = (List<ResourceMatch>)ViewBag.MatchedResources;
}
<div class="mt-4">
    <h6 class="text-muted mb-2">Resources automatically matched to this job seeker</h6>
    @if (!matchedResources.Any())
    {
        <p class="text-muted small">No published resources currently match this job seeker's profile or applied jobs.</p>
    }
    else
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var match in matchedResources)
            {
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body py-2 px-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-semibold">@match.Resource.Title</span>
                            <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis">@match.Resource.ResourceType</span>
                        </div>
                        @foreach (var reason in match.Reasons)
                        {
                            <div class="small text-muted">@reason</div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
