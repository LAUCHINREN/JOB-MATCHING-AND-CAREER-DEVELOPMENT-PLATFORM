                    <div class="card tile-hover bg-success-subtle border-0 rounded-4 shadow-sm h-100 @(Model.SelectedStatus == key ? "border border-2 border-success" : "")" style="min-width:110px;">
                        <div class="card-body text-center py-3">
                            <div class="fs-3 fw-bold text-success-emphasis">@GetCount(key)</div>
                            <div class="small text-success-emphasis">@label</div>
