@model ApplicantDashboardViewModel

@{
    ViewData["Title"] = "Applicant Tracking";
    int total = Model.StatusCounts.Values.Sum();
    int GetCount(string key) => Model.StatusCounts.GetValueOrDefault(key, 0);
    string[] activeStatuses = { "Submitted", "Under Review", "Shortlisted", "Interview", "Offered" };
    var newReviewTiles = new[] { ("New", "Submitted"), ("Review", "Under Review") };
    var progressTiles = new[] { ("Shortlisted", "Shortlisted"), ("Interview", "Interview"), ("Offered", "Offered") };
}

<style>
    .fit-score-badge {
        cursor: pointer;
        transition: filter 0.15s ease;
    }

    .fit-score-badge:hover {
        filter: brightness(0.85);
    }

    .tile-hover {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .tile-hover:hover {
        transform: translateY(-3px);
        box-shadow: 0 0.75rem 1.25rem rgba(0,0,0,0.10) !important;
    }

    .tile-selected {
        transform: translateY(-3px);
        box-shadow: 0 0.75rem 1.25rem rgba(0,0,0,0.12) !important;
    }

    .tile-primary {
        border-top: 4px solid var(--bs-primary) !important;
    }

    .tile-info {
        border-top: 4px solid var(--bs-info) !important;
    }

    .tile-success {
        border-top: 4px solid var(--bs-success) !important;
    }

    .tile-danger {
        border-top: 4px solid var(--bs-danger) !important;
    }

    .tile-check {
        position: absolute;
        top: -8px;
        right: -8px;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        color: #fff;
        box-shadow: 0 0.15rem 0.35rem rgba(0,0,0,0.25);
        z-index: 1;
    }
</style>

<div class="bg-light rounded-4 p-4">

    <div class="d-flex justify-content-between align-items-center bg-white rounded-4 shadow-sm p-3 mb-4">
        <h4 class="mb-0">Applicant Tracking</h4>
    </div>

    @if (TempData["StatusError"] != null)
    {
        <div class="alert alert-danger">@TempData["StatusError"]</div>
    }

