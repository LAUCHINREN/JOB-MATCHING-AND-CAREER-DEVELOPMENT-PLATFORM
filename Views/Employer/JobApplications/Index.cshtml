    }
    else
    {
        <div class="card border-0 rounded-4 shadow-sm mb-4">
            <div class="card-body p-0">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3">Candidate</th>
                            <th>Recommendation</th>
                            <th>Assessments</th>
                            <th>Job Applied For</th>
                            <th>Applied Date</th>
                            <th>Cover Message</th>
                            <th>Status</th>
                            <th>Resume/CV</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model.Applications)
                        {
                            bool isActive = activeStatuses.Contains(app.Status);
                            <tr>
                                <td class="ps-3 align-self-auto">@(Model.Profiles.GetValueOrDefault(app.UserId)?.FullName ?? Model.Names.GetValueOrDefault(app.UserId))</td>
                                <td>
                                    @{
                                        int score = Model.FitScores.GetValueOrDefault(app.JobApplicationId, 0);
                                        string badgeClass = score >= 70 ? "bg-success-subtle text-success-emphasis"
                                                           : score >= 40 ? "bg-warning-subtle text-warning-emphasis"
                                                           : "bg-danger-subtle text-danger-emphasis";
                                    }
                                    @* <span class="badge rounded-pill @badgeClass">@score%</span> *@
                                    <span class="badge rounded-pill @badgeClass px-3 py-2 fs-6 fw-semibold fit-score-badge"
                                          data-bs-toggle="modal" data-bs-target="#fitScoreModal-@app.JobApplicationId" role="button">@score%</span>
                                </td>
                                <td>
                                    @{
                                        var results = Model.AssessmentsByApplicant.GetValueOrDefault(app.UserId) ?? new List<AssessmentResult>();
                                        int passedCount = results.Count(r => r.IsPassed);
                                    }
                                    @if (results.Any())
                                    {
                                        string assessBadgeClass = passedCount == results.Count ? "bg-success-subtle text-success-emphasis"
                                                                 : passedCount > 0 ? "bg-warning-subtle text-warning-emphasis"
                                                                 : "bg-danger-subtle text-danger-emphasis";
                                        <span class="badge rounded-pill @assessBadgeClass px-3 py-2 fw-semibold fit-score-badge"
                                              data-bs-toggle="modal" data-bs-target="#assessmentModal-@app.JobApplicationId" role="button">
                                            @passedCount/@results.Count passed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No assessments taken</span>
                                    }
                                </td>
                                <td>@app.JobPosting?.JobTitle</td>
                                <td>@app.AppliedDate.ToString("d MMM yyyy")</td>
                                <td style="max-width:280px;">@app.CoverMessage</td>
                                <td>
                                    @if (isActive)
                                    {
                                        @* <form asp-action="UpdateStatus" method="post" class="d-flex gap-1 mb-1">
                                            <input type="hidden" name="id" value="@app.JobApplicationId" />
                                            <input type="hidden" name="vacancyId" value="@Model.SelectedVacancyId" />
                                            <input type="hidden" name="status" value="@Model.SelectedStatus" />
                                            <input type="hidden" name="search" value="@Model.Search" />
                                            <select name="newStatus" class="form-select form-select-sm">
                                                @foreach (var s in activeStatuses)
                                                {
                                                    <option value="@s" selected="@(s == app.Status ? "selected" : null)">@s</option>
                                                }
                                            </select>
                                            <button type="submit" class="btn btn-outline-primary btn-sm">Update</button>
                                        </form>
                                        <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#rejectModal-@app.JobApplicationId">
                                            Reject
                                        </button> *@
                                        <div class="d-flex gap-1 align-items-center flex-nowrap mx-2">
                                            <form asp-action="UpdateStatus" method="post" class="d-flex gap-1 align-items-center flex-grow-1" style="min-width:0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@app.JobApplicationId" />
                                                <input type="hidden" name="vacancyId" value="@Model.SelectedVacancyId" />
                                                <input type="hidden" name="status" value="@Model.SelectedStatus" />
                                                <input type="hidden" name="search" value="@Model.Search" />
                                                <select name="newStatus" class="form-select form-select-sm flex-grow-1" style="min-width:0;">
                                                    @foreach (var s in activeStatuses)
                                                    {
                                                        <option value="@s" selected="@(s == app.Status ? "selected" : null)">@s</option>
                                                    }
                                                </select>
                                                <button type="submit" class="btn btn-outline-primary btn-sm flex-shrink-0">Update</button>
                                            </form>
                                            <button type="button" class="btn btn-outline-danger btn-sm flex-shrink-0" data-bs-toggle="modal" data-bs-target="#rejectModal-@app.JobApplicationId">
                                                Reject
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mx-2">
                                            <span class="badge @(app.Status == "Rejected" ? "bg-danger" : "bg-secondary")">@app.Status</span>
                                            @if (app.Status == "Rejected" && !string.IsNullOrEmpty(app.RejectionNote))
                                            {
                                                <div class="small text-muted mt-1">Reason: @app.RejectionNote</div>
                                            }
                                        </div>
   
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(Model.Profiles.GetValueOrDefault(app.UserId)?.ResumeS3Key))
                                    {
                                        <a asp-action="DownloadResume" asp-route-id="@app.JobApplicationId" class="btn btn-outline-secondary btn-sm" target="_blank"
                                           rel="noopener noreferrer">Download</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Not uploaded</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

@foreach (var app in Model.Applications.Where(a => activeStatuses.Contains(a.Status)))
{
    <div class="modal fade" id="rejectModal-@app.JobApplicationId" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form asp-action="UpdateStatus" method="post">
                <input type="hidden" name="id" value="@app.JobApplicationId" />
                <input type="hidden" name="newStatus" value="Rejected" />
                <input type="hidden" name="vacancyId" value="@Model.SelectedVacancyId" />
                <input type="hidden" name="status" value="@Model.SelectedStatus" />
                <input type="hidden" name="search" value="@Model.Search" />
                <div class="modal-content rounded-4">
                    <div class="modal-header">
                        <h5 class="modal-title">Reject @(Model.Profiles.GetValueOrDefault(app.UserId)?.FullName ?? Model.Names.GetValueOrDefault(app.UserId))</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">Reason for rejection</label>
                        <textarea name="rejectionNote" class="form-control" rows="3" maxlength="500" required></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Confirm Reject</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@* ← new fit-score loop starts right here, as its own separate foreach *@
@foreach (var app in Model.Applications)
{
    <div class="modal fade" id="fitScoreModal-@app.JobApplicationId" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content rounded-4">
                <div class="modal-header">
                    <h5 class="modal-title">Fit Score Breakdown — @(Model.Profiles.GetValueOrDefault(app.UserId)?.FullName ?? Model.Names.GetValueOrDefault(app.UserId))</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Aspect</th>
                                <th>Status</th>
                                <th class="text-end">Score</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var aspect in Model.FitBreakdowns[app.JobApplicationId])
                            {
                                <tr>
                                    <td>@aspect.Aspect</td>
                                    <td>
                                        @if (aspect.MaxPoints > 0 && aspect.PointsEarned == aspect.MaxPoints)
                                        {
                                            <span class="text-success">&#10003; Matched</span>
                                        }
                                        else if (aspect.PointsEarned > 0)
                                        {
                                            <span class="text-warning">&#9680; Partial Match</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">&#10007; No Match</span>
                                        }
                                    </td>
                                    <td class="text-end">@aspect.PointsEarned%</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold border-top">
                                <td colspan="2">Total Score</td>
                                <td class="text-end">@Model.FitScores.GetValueOrDefault(app.JobApplicationId, 0)%</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@* Assessment results modal — every skill assessment this applicant has taken *@
@foreach (var app in Model.Applications)
{
    var results = Model.AssessmentsByApplicant.GetValueOrDefault(app.UserId) ?? new List<AssessmentResult>();
    <div class="modal fade" id="assessmentModal-@app.JobApplicationId" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content rounded-4">
                <div class="modal-header">
                    <h5 class="modal-title">Assessment Results — @(Model.Profiles.GetValueOrDefault(app.UserId)?.FullName ?? Model.Names.GetValueOrDefault(app.UserId))</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (!results.Any())
                    {
                        <p class="text-muted mb-0">This applicant has not taken any skill assessments yet.</p>
                    }
                    else
                    {
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Assessment</th>
                                    <th>Skill</th>
                                    <th class="text-end">Score</th>
                                    <th>Result</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var result in results)
                                {
                                    Model.AssessmentCatalog.TryGetValue(result.SkillAssessmentId, out var assessment);
                                    <tr>
                                        <td>@(assessment?.Title ?? "Unknown Assessment")</td>
                                        <td>@(assessment?.SkillName ?? "-")</td>
                                        <td class="text-end">@result.Score%</td>
                                        <td>
                                            @if (result.IsPassed)
                                            {
                                                <span class="text-success">&#10003; Passed</span>
                                            }
                                            else
                                            {
                                                <span class="text-danger">&#10007; Failed</span>
                                            }
                                        </td>
                                        <td>@result.CompletedDate.ToString("d MMM yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}