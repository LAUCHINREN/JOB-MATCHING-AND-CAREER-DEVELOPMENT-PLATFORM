                    </div>
                </a>
            }
        </div>

        <div class="vr d-none d-md-block"></div>

        <a asp-action="Index" asp-route-vacancyId="@Model.SelectedVacancyId" asp-route-search="@Model.Search" asp-route-status="Rejected" class="text-decoration-none">
            <div class="card tile-hover bg-danger-subtle border-0 rounded-4 shadow-sm h-100 @(Model.SelectedStatus == "Rejected" ? "border border-2 border-danger" : "")" style="min-width:110px;">
