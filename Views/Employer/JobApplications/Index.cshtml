                </div>
            </div>
        </a>
        <div class="vr d-none d-md-block"></div>
        <div class="d-flex gap-2">
            @foreach (var (label, key) in newReviewTiles)
            {
                bool selected = Model.SelectedStatus == key;
                <a asp-action="Index" asp-route-vacancyId="@Model.SelectedVacancyId" asp-route-search="@Model.Search" asp-route-status="@key" class="text-decoration-none">
                    <div class="card tile-hover position-relative bg-info-subtle border-0 rounded-4 shadow-sm h-100 @(selected ? "tile-selected tile-info" : "")" style="min-width:110px;">
                        @if (selected)
