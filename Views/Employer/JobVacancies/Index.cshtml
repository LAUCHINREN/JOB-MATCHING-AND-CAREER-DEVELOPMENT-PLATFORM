@model List<JobPosting>
@{
    ViewData["Title"] = "Job Posts";
    string currentTab = ViewData["CurrentTab"] as string ?? "Approved";
    string? currentSearch = ViewData["CurrentSearch"] as string;
}

<style>
    .card-hover {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

        .card-hover:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.75rem 1.25rem rgba(0,0,0,0.08) !important;
        }
</style>

<div class="bg-light rounded-4 p-4">
    <div class="d-flex justify-content-between align-items-center bg-white rounded-4 shadow-sm p-3 mb-4">
        <h4 class="mb-0">Job Posts</h4>
        <ul class="nav nav-tabs border-0">
            @foreach (var t in new[] { "Approved", "Pending", "Rejected", "Closed" })
            {
                <li class="nav-item">
                    <a class="nav-link @(t == currentTab ? "active fw-semibold" : "text-secondary")"
                       asp-action="Index" asp-route-tab="@t" asp-route-search="@currentSearch">@t</a>
                </li>
            }
        </ul>
    </div>

    <div class="card border-0 rounded-4 shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="d-flex justify-content-between align-items-center">
                <input type="hidden" name="tab" value="@currentTab" />
                <div class="input-group" style="max-width: 340px;">
                    <input type="text" name="search" class="form-control" placeholder="Search job title..." value="@currentSearch" />
                    <button class="btn btn-outline-secondary" type="submit">Search</button>
                </div>
                <a asp-action="AddData" class="btn btn-primary rounded-pill px-4">+ Create Job Post</a>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-light border text-center text-muted rounded-4">
            No job posts found in this tab.
        </div>
    }

    @foreach (var job in Model)
    {
        <div class="card card-hover mb-3 rounded-4 shadow-sm border-0">
            <div class="card-body d-flex justify-content-between align-items-start">
                <div>
                    <h5 class="card-title mb-1">@job.JobTitle</h5>
                    @if (!string.IsNullOrEmpty(job.EmploymentType))
                    {
                        <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis mb-2">@job.EmploymentType</span>
                    }
                    <p class="text-muted small mb-0">Created at @job.CreatedAt.ToString("d MMM yyyy")</p>
                    @if (currentTab == "Closed")
                    {
                        <p class="mt-2 mb-0"><strong>Closed Reason:</strong> @job.CloseReason</p>
                    }
                    @if (currentTab == "Rejected")
                    {
                        <p class="mt-2 mb-0"><strong>Rejected Reason:</strong> @job.RejectionReason</p>
                    }
                </div>
                <div class="d-flex flex-column gap-2" style="min-width:130px;">
                    <a asp-action="ViewPost" asp-route-id="@job.JobId" class="btn btn-outline-secondary btn-sm rounded-pill">View</a>
                    @if (currentTab == "Approved")
                    {
                        <button type="button" class="btn btn-outline-danger btn-sm rounded-pill"
                                data-bs-toggle="modal" data-bs-target="#closeModal-@job.JobId">
                            Close
                        </button>
                    }
                    @if (currentTab == "Closed")
                    {
                        <form asp-action="Reopen" asp-route-id="@job.JobId" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-success btn-sm rounded-pill w-100">Reopen</button>
                        </form>
                    }
                    @if (currentTab == "Pending" || currentTab == "Rejected")
                    {
                        <form asp-action="Delete" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@job.JobId" />
                            <input type="hidden" name="tab" value="@currentTab" />
                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill w-100">Delete</button>
                        </form>
                    }
                </div>
            </div>
        </div>
        @if (currentTab == "Approved")
        {
            <div class="modal fade" id="closeModal-@job.JobId" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <form asp-action="Close" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="JobVacancyId" value="@job.JobId" />
                        <div class="modal-content rounded-4">
                            <div class="modal-header">
                                <h5 class="modal-title">Close "@job.JobTitle"</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <label class="form-label">Reason for closing</label>
                                <textarea name="CloseReason" class="form-control" rows="3" maxlength="500" required></textarea>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-danger">Confirm Close</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        }
    }
</div>

