@model IEnumerable<JobCareerPlatform.Data.ApplicationUser>

@{
    ViewData["Title"] = "User Management";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between
            align-items-center mb-4">

    <div>
        <h3 class="fw-bold mb-1">
            User Management
        </h3>

        <p class="text-muted mb-0">
            Manage platform user accounts and access.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary px-4">
        + Add User
    </a>

</div>

<div class="admin-panel mb-4">

    <form method="get">

        <div class="row g-3">

            <div class="col-lg-4">

                <label class="form-label">
                    Search
                </label>

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search name or email..." />

            </div>

            <div class="col-lg-2">

                <label class="form-label">
                    Role
                </label>

                <select name="role" class="form-select">

                    <option value=""
                            selected="@(string.IsNullOrEmpty(ViewBag.Role) ? "selected" : null)">
                        All Roles
                    </option>

                    <option value="JobSeeker"
                            selected="@(ViewBag.Role == "JobSeeker" ? "selected" : null)">
                        Job Seeker
                    </option>

                    <option value="Employer"
                            selected="@(ViewBag.Role == "Employer" ? "selected" : null)">
                        Employer
                    </option>

                    <option value="CareerAdvisor"
                            selected="@(ViewBag.Role == "CareerAdvisor" ? "selected" : null)">
                        Career Advisor
                    </option>

                    <option value="SystemAdmin"
                            selected="@(ViewBag.Role == "SystemAdmin" ? "selected" : null)">
                        System Admin
                    </option>

                </select>

            </div>


            <div class="col-lg-2">

                <label class="form-label">
                    Status
                </label>

                <select name="status" class="form-select">

                    <option value=""
                            selected="@(string.IsNullOrEmpty(ViewBag.Status) ? "selected" : null)">
                        All Status
                    </option>

                    <option value="Active"
                            selected="@(ViewBag.Status == "Active" ? "selected" : null)">
                        Active
                    </option>

                    <option value="Suspended"
                            selected="@(ViewBag.Status == "Suspended" ? "selected" : null)">
                        Suspended
                    </option>

                    <option value="Deactivated"
                            selected="@(ViewBag.Status == "Deactivated" ? "selected" : null)">
                        Deactivated
                    </option>

                </select>

            </div>

            <div class="col-lg-2 d-flex align-items-end">
                <a asp-action="Index"
                   class="btn btn-outline-secondary w-100">
                    Reset
                </a>
            </div>

            <div class="col-lg-2 d-flex align-items-end">

                <button type="submit"
                        class="btn btn-primary w-100">

                    Search

                </button>

            </div>

        </div>

    </form>

</div>

<div class="admin-panel">

    <div class="table-responsive">

        <table class="table align-middle">

            <thead>

                <tr>

                    <th>User</th>

                    <th>Role</th>

                    <th>Status</th>

                    <th>Registered</th>

                    <th class="text-end">
                        Actions
                    </th>

                </tr>

            </thead>

            <tbody>

                @foreach (var user in Model)
                {
                    <tr>

                        <td>

                            <div class="fw-semibold">
                                @user.FullName
                            </div>

                            <small class="text-muted">
                                @user.Email
                            </small>

                        </td>


                        <td>
                            @{
                                var displayRole = user.UserRole switch
                                {
                                    "JobSeeker" => "Job Seeker",
                                    "Job Seeker" => "Job Seeker",

                                    "CareerAdvisor" => "Career Advisor",
                                    "Career Advisor" => "Career Advisor",

                                    "SystemAdmin" => "System Admin",
                                    "System Admin" => "System Admin",

                                    _ => user.UserRole
                                };
                            }

                            @displayRole
                        </td>


                        <td>

                            @if (user.AccountStatus == "Active")
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else if (user.AccountStatus == "Suspended")
                            {
                                <span class="badge bg-warning text-dark">
                                    Suspended
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Deactivated
                                </span>
                            }

                        </td>


                        <td>
                            @user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                        </td>


                        <td class="text-end">

                            <a asp-action="Details"
                               asp-route-id="@user.Id"
                               class="btn btn-sm btn-outline-primary">

                                View

                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@user.Id"
                               class="btn btn-sm btn-outline-secondary">

                                Edit

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>