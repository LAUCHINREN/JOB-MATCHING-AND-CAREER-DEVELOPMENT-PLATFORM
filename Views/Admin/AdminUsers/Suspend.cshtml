@model JobCareerPlatform.Models.Admin.AdminAccountActionViewModel

@{
    ViewData["Title"] = "Suspend User";
    Layout = "_AdminLayout";
}

<div class="mb-4">

    <a asp-action="Details"
       asp-route-id="@Model.UserId"
       class="text-decoration-none">
        ← Back to User Details
    </a>

    <h3 class="fw-bold mt-3 mb-1">
        Suspend Account
    </h3>

    <p class="text-muted">
        Temporarily block this user from accessing the platform.
    </p>

</div>

<div class="admin-panel">

    <div class="alert alert-warning">

        <strong>@Model.UserName</strong><br />
        @Model.Email

    </div>

    <form asp-action="Suspend"
          method="post">

        <input asp-for="UserId"
               type="hidden" />

        <input asp-for="UserName"
               type="hidden" />

        <input asp-for="Email"
               type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-4">

            <label asp-for="Reason"
                   class="form-label fw-semibold">
            </label>

            <textarea asp-for="Reason"
                      class="form-control"
                      rows="4"
                      placeholder="Explain why this account is being suspended..."></textarea>

            <span asp-validation-for="Reason"
                  class="text-danger"></span>

            <small class="text-muted">
                The reason will be recorded in the Admin Audit Log.
            </small>

        </div>

        <div class="d-flex justify-content-end gap-2">

            <a asp-action="Details"
               asp-route-id="@Model.UserId"
               class="btn btn-outline-secondary">
                Cancel
            </a>

            <button type="submit"
                    class="btn btn-warning">
                Confirm Suspension
            </button>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}