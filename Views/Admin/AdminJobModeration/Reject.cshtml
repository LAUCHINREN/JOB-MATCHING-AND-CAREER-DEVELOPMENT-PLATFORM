@model JobCareerPlatform.Models.Admin.RejectJobViewModel

@{
    ViewData["Title"] = "Reject Job Posting";
    Layout = "_AdminLayout";
}

<div class="mb-4">

    <a asp-action="Details"
       asp-route-id="@Model.JobId"
       class="text-decoration-none">
        ← Back to Job Review
    </a>

    <h3 class="fw-bold mt-3 mb-1">
        Reject Job Posting
    </h3>

    <p class="text-muted">
        Provide a reason for rejecting this job vacancy.
    </p>

</div>

<div class="admin-panel">

    <div class="alert alert-warning">

        <strong>
            @Model.JobTitle
        </strong>

        <br />

        Employer:
        @Model.EmployerName

    </div>


    <form asp-action="Reject"
          method="post">

        <input asp-for="JobId"
               type="hidden" />

        <input asp-for="JobTitle"
               type="hidden" />

        <input asp-for="EmployerName"
               type="hidden" />


        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>


        <div class="mb-4">

            <label asp-for="Reason"
                   class="form-label fw-semibold">
            </label>

            <textarea asp-for="Reason"
                      class="form-control"
                      rows="5"
                      placeholder="Example: Company information could not be verified."></textarea>

            <span asp-validation-for="Reason"
                  class="text-danger"></span>

            <small class="text-muted">

                This reason will be recorded in the
                moderation history.

            </small>

        </div>


        <div class="d-flex justify-content-end gap-2">

            <a asp-action="Details"
               asp-route-id="@Model.JobId"
               class="btn btn-outline-secondary">

                Cancel

            </a>

            <button type="submit"
                    class="btn btn-danger">

                Confirm Rejection

            </button>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}