@model JobCareerPlatform.Models.UserActivityLogViewModel

@{
    ViewData["Title"] = "Activity Details";
    Layout = "_AdminLayout";
}

<div class="mb-4">

    <a asp-action="Index"
       class="text-decoration-none">
        ← Back to Activity Monitoring
    </a>

    <h3 class="fw-bold mt-3 mb-1">
        Activity Details
    </h3>

    <p class="text-muted mb-0">
        Detailed information about this user activity.
    </p>

</div>


<div class="row g-4">

    <div class="col-lg-8">

        <div class="admin-panel">

            <h5 class="mb-4">
                Activity Information
            </h5>


            <div class="row">

                <div class="col-md-6 mb-4">

                    <small class="text-muted">
                        ACTIVITY
                    </small>

                    <div class="fw-semibold mt-1">
                        @Model.ActivityType
                    </div>

                </div>


                <div class="col-md-6 mb-4">

                    <small class="text-muted">
                        MODULE
                    </small>

                    <div class="fw-semibold mt-1">
                        @(string.IsNullOrWhiteSpace(Model.EntityType)
                                                ? "-"
                                                : Model.EntityType)
                    </div>

                </div>


                <div class="col-md-6 mb-4">

                    <small class="text-muted">
                        RECORD ID
                    </small>

                    <div class="fw-semibold mt-1">
                        @(string.IsNullOrWhiteSpace(Model.EntityId)
                                                ? "-"
                                                : Model.EntityId)
                    </div>

                </div>


                <div class="col-md-6 mb-4">

                    <small class="text-muted">
                        DATE & TIME
                    </small>

                    <div class="fw-semibold mt-1">

                        @(Model.CreatedAt
                                                .ToLocalTime()
                                                .ToString("dd/MM/yyyy hh:mm tt"))

                    </div>

                </div>

            </div>


            <hr />


            <div>

                <small class="text-muted">
                    DESCRIPTION
                </small>

                <div class="mt-2">

                    @(string.IsNullOrWhiteSpace(Model.Description)
                                        ? "-"
                                        : Model.Description)

                </div>

            </div>

        </div>

    </div>


    <div class="col-lg-4">

        <div class="admin-panel">

            <h5 class="mb-4">
                User Information
            </h5>


            <small class="text-muted">
                USER NAME
            </small>

            <div class="fw-semibold mt-1 mb-4">
                @Model.UserName
            </div>


            <small class="text-muted">
                EMAIL
            </small>

            <div class="fw-semibold mt-1 mb-4">
                @Model.UserEmail
            </div>


            <small class="text-muted">
                ROLE
            </small>

            <div class="fw-semibold mt-1 mb-4">
                @Model.UserRole
            </div>


            <small class="text-muted">
                USER ID
            </small>

            <div class="small mt-1 text-break">
                @Model.UserId
            </div>

        </div>

    </div>

</div>