@model List<JobCareerPlatform.Models.ResourceMatch>

@{
    Layout = "_JobSeekerLayout";
    ViewData["Title"] = "My Recommendations";
}

<div class="py-3" style="width:100%;max-width:1400px;margin:0 auto;">

    <div class="mb-4">
        <span class="badge rounded-pill" style="background:#eaf1ff;color:#2563eb;">
            <i class="bi bi-mortarboard me-1"></i> Career Guidance
        </span>
        <h2 class="fw-bold mb-1 mt-2">Recommended For You</h2>
        <p class="text-muted mb-0">
            Automatically matched to your preferred job category, field of study, and the skills
            required by jobs you've applied to.
        </p>
    </div>

    <partial name="_CareerGuidanceSubNav" />

    @if (!Model.Any())
    {
        <div class="text-center border rounded-4 p-5 text-muted" style="border-style:dashed !important;">
            Nothing matches your profile yet. Try completing your Career Profile (field of study,
            preferred job category) or applying to a few jobs — resources will be matched automatically.
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var match in Model)
            {
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body">
                        <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis mb-2">@match.Resource.ResourceType</span>
                        <h5 class="mb-1">@match.Resource.Title</h5>
                        <p class="text-muted small mb-2">@match.Resource.Description</p>
                        <div class="p-2 rounded-3" style="background:#f8fafc;border:1px solid #edf0f4;">
                            <span class="text-muted small fw-semibold">Why this was recommended:</span>
                            @foreach (var reason in match.Reasons)
                            {
                                <div class="small">@reason</div>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(match.Resource.ContentUrl))
                        {
                            <a href="@match.Resource.ContentUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary btn-sm rounded-pill mt-2">Open Resource</a>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
