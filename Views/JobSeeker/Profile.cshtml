@model JobCareerPlatform.Models.JobSeekerProfile

@{
    Layout = "_JobSeekerLayout";
    ViewData["Title"] = "Career Profile";
    var skills = ViewBag.Skills as List<JobSeekerSkill>;

}

<div class="py-3">

    <div class="profile-page">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm"
                 role="alert">

                <i class="bi bi-check-circle-fill me-2"></i>

                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm"
                 role="alert">

                <i class="bi bi-exclamation-circle-fill me-2"></i>

                @TempData["ErrorMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }

        <div class="card profile-card border-0 shadow-sm overflow-hidden">

            <!-- Profile Header -->
            <div class="profile-header">

                <div class="d-flex flex-column flex-md-row
                            justify-content-between
                            align-items-md-center
                            gap-4">

                    <div class="d-flex align-items-center gap-3">

                        <div class="profile-avatar">
                            <i class="bi bi-person-fill"></i>
                        </div>

                        <div>
                            <div class="profile-label">
                                Job Seeker Profile
                            </div>

                            <h2 class="fw-bold text-white mb-1">
                                @Model.FullName
                            </h2>

                            <div class="text-white-50">

                                <i class="bi bi-briefcase me-1"></i>

                                @(string.IsNullOrWhiteSpace(Model.PreferredJobCategory)
                                                                ? "Career preference not provided"
                                                                : Model.PreferredJobCategory)

                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.PreferredLocation))
                            {
                                <div class="text-white-50 mt-1">

                                    <i class="bi bi-geo-alt me-1"></i>

                                    @Model.PreferredLocation

                                </div>
                            }

                        </div>

                    </div>

                    <div>
                        <a asp-action="EditProfile"
                           class="btn btn-light edit-button">

                            <i class="bi bi-pencil-square me-2"></i>
                            Edit Profile

                        </a>
                    </div>

                </div>

            </div>


            <div class="card-body profile-body">

                <!-- Career Objective -->
                <div class="content-section">

                    <div class="section-heading">
                        <div class="section-heading-icon">
                            <i class="bi bi-bullseye"></i>
                        </div>

                        <div>
                            <h5 class="fw-bold mb-0">
                                Career Objective
                            </h5>

                            <small class="text-muted">
                                Your professional goals and career interests
                            </small>
                        </div>
                    </div>

                    <div class="career-box mt-3">

                        @if (!string.IsNullOrWhiteSpace(Model.CareerObjective))
                        {
                            <p class="mb-0">
                                @Model.CareerObjective
                            </p>
                        }
                        else
                        {
                            <span class="text-muted">
                                No career objective added yet.
                            </span>
                        }

                    </div>

                </div>


                <hr class="section-divider" />


                <!-- Personal Information -->
                <div class="content-section">

                    <div class="section-heading mb-4">

                        <div class="section-heading-icon">
                            <i class="bi bi-person-vcard"></i>
                        </div>

                        <div>
                            <h5 class="fw-bold mb-0">
                                Personal Information
                            </h5>

                            <small class="text-muted">
                                Contact and basic career details
                            </small>
                        </div>

                    </div>


                    <div class="row g-3">

                        <!-- Contact -->
                        <div class="col-md-6 col-xl-4">

                            <div class="info-card">

                                <div class="info-icon">
                                    <i class="bi bi-telephone"></i>
                                </div>

                                <div>
                                    <span class="info-label">
                                        Contact Number
                                    </span>

                                    <div class="info-value">

                                        @(string.IsNullOrWhiteSpace(Model.ContactNumber)
                                                                                ? "Not provided"
                                                                                : Model.ContactNumber)

                                    </div>
                                </div>

                            </div>

                        </div>


                        <!-- Education -->
                        <div class="col-md-6 col-xl-4">

                            <div class="info-card">

                                <div class="info-icon">
                                    <i class="bi bi-mortarboard"></i>
                                </div>

                                <div>
                                    <span class="info-label">
                                        Education Level
                                    </span>

                                    <div class="info-value">

                                        @(string.IsNullOrWhiteSpace(Model.EducationLevel)
                                                                                ? "Not provided"
                                                                                : Model.EducationLevel)

                                    </div>
                                </div>

                            </div>

                        </div>


                        <!-- Field of Study -->
                        <div class="col-md-6 col-xl-4">

                            <div class="info-card">

                                <div class="info-icon">
                                    <i class="bi bi-book"></i>
                                </div>

                                <div>
                                    <span class="info-label">
                                        Field of Study
                                    </span>

                                    <div class="info-value">

                                        @(string.IsNullOrWhiteSpace(Model.FieldOfStudy)
                                                                                ? "Not provided"
                                                                                : Model.FieldOfStudy)

                                    </div>
                                </div>

                            </div>

                        </div>


                        <!-- Experience -->
                        <div class="col-md-6 col-xl-4">

                            <div class="info-card">

                                <div class="info-icon">
                                    <i class="bi bi-briefcase"></i>
                                </div>

                                <div>
                                    <span class="info-label">
                                        Work Experience
                                    </span>

                                    <div class="info-value">
                                        @Model.ExperienceYears year(s)
                                    </div>
                                </div>

                            </div>

                        </div>


                        <!-- Location -->
                        <div class="col-md-6 col-xl-4">

                            <div class="info-card">

                                <div class="info-icon">
                                    <i class="bi bi-geo-alt"></i>
                                </div>

                                <div>
                                    <span class="info-label">
                                        Preferred Location
                                    </span>

                                    <div class="info-value">

                                        @(string.IsNullOrWhiteSpace(Model.PreferredLocation)
                                                                                ? "Not provided"
                                                                                : Model.PreferredLocation)

                                    </div>
                                </div>

                            </div>

                        </div>


                        <!-- Salary -->
                        <div class="col-md-6 col-xl-4">

                            <div class="info-card">

                                <div class="info-icon">
                                    <i class="bi bi-cash-stack"></i>
                                </div>

                                <div>
                                    <span class="info-label">
                                        Expected Salary
                                    </span>

                                    <div class="info-value">

                                        @if (Model.ExpectedSalary.HasValue)
                                        {
                                            <span>
                                                RM @Model.ExpectedSalary.Value.ToString("N2")
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                Not provided
                                            </span>
                                        }

                                    </div>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <hr class="section-divider" />


                <!-- Career Preference -->
                <div class="content-section">

                    <div class="section-heading mb-3">

                        <div class="section-heading-icon">
                            <i class="bi bi-stars"></i>
                        </div>

                        <div>
                            <h5 class="fw-bold mb-0">
                                Career Preference
                            </h5>

                            <small class="text-muted">
                                Your preferred career direction
                            </small>
                        </div>

                    </div>


                    <div class="preference-card">

                        <div>

                            <span class="info-label">
                                Preferred Job Category
                            </span>

                            <div class="fw-semibold mt-1">

                                @(string.IsNullOrWhiteSpace(Model.PreferredJobCategory)
                                                                ? "Not provided"
                                                                : Model.PreferredJobCategory)

                            </div>

                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.PreferredJobCategory))
                        {
                            <span class="badge preference-badge">
                                @Model.PreferredJobCategory
                            </span>
                        }

                    </div>

                </div>

                <hr class="section-divider" />

                <!-- Skills -->
                <div class="content-section">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div class="section-heading">
                            <div class="section-heading-icon">
                                <i class="bi bi-lightning-charge"></i>
                            </div>

                            <div>
                                <h5 class="fw-bold mb-0">
                                    Skills
                                </h5>

                                <small class="text-muted">
                                    Your technical and professional skills
                                </small>
                            </div>
                        </div>

                        <a asp-action="AddSkill"
                           class="btn btn-primary btn-sm rounded-3 px-3">

                            <i class="bi bi-plus-lg me-1"></i>
                            Add Skill
                        </a>

                    </div>

                    @if (skills != null && skills.Any())
                    {
                        <div class="row g-3">

                            @foreach (var skill in skills)
                            {
                                <div class="col-md-6 col-xl-4">

                                    <div class="skill-card">

                                        <div class="skill-info">

                                            <div class="skill-icon">
                                                <i class="bi bi-lightning-charge-fill"></i>
                                            </div>

                                            <div>
                                                <div class="fw-semibold skill-name">
                                                    @skill.SkillName
                                                </div>

                                                <span class="skill-level">
                                                    @skill.ProficiencyLevel
                                                </span>
                                            </div>

                                        </div>

                                        <div class="dropdown">

                                            <button class="btn btn-sm skill-menu"
                                                    type="button"
                                                    data-bs-toggle="dropdown"
                                                    aria-expanded="false">

                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>

                                            <ul class="dropdown-menu dropdown-menu-end">

                                                <li>
                                                    <a class="dropdown-item"
                                                       asp-action="EditSkill"
                                                       asp-route-id="@skill.JobSeekerSkillId">

                                                        <i class="bi bi-pencil me-2"></i>
                                                        Edit
                                                    </a>
                                                </li>

                                                <li>
                                                    <form asp-action="DeleteSkill"
                                                          asp-route-id="@skill.JobSeekerSkillId"
                                                          method="post">

                                                        <button type="submit"
                                                                class="dropdown-item text-danger"
                                                                onclick="return confirm('Are you sure you want to delete this skill?');">

                                                            <i class="bi bi-trash me-2"></i>
                                                            Delete
                                                        </button>

                                                    </form>
                                                </li>

                                            </ul>

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="empty-skills">

                            <div class="empty-skill-icon">
                                <i class="bi bi-lightning-charge"></i>
                            </div>

                            <div>
                                <h6 class="fw-semibold mb-1">
                                    No skills added yet
                                </h6>

                                <p class="text-muted small mb-0">
                                    Add your skills to improve your profile and future job recommendations.
                                </p>
                            </div>

                            <a asp-action="AddSkill"
                               class="btn btn-outline-primary btn-sm ms-md-auto">

                                <i class="bi bi-plus-lg me-1"></i>
                                Add First Skill
                            </a>

                        </div>
                    }

                </div>


                <!-- Bottom Actions -->
                <div class="bottom-actions">

                    <a asp-action="Home"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left me-1"></i>
                        Back to Dashboard

                    </a>

                </div>


                <!-- Danger Zone -->
                <div class="danger-zone">

                    <div class="danger-content">

                        <div class="danger-icon">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>

                        <div>

                            <div class="fw-semibold text-danger">
                                Delete Career Profile
                            </div>

                            <div class="text-muted small">
                                This will permanently remove your career profile information.
                                Your login account will remain active.
                            </div>

                        </div>

                    </div>


                    <form asp-action="DeleteProfile"
                          method="post"
                          onsubmit="return confirm('Are you sure you want to delete your career profile? This action cannot be undone.');">

                        <button type="submit"
                                class="btn btn-outline-danger">

                            <i class="bi bi-trash me-1"></i>
                            Delete Profile

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    .profile-page {
        width: 100%;
        max-width: 1350px;
        margin: 0 auto;
    }


    .profile-card {
        border-radius: 18px !important;
        background: white;
    }


    .profile-header {
        padding: 28px 32px;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
    }


    .profile-avatar {
        width: 66px;
        height: 66px;
        border-radius: 18px;
        background: rgba(255, 255, 255, .16);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 28px;
    }


    .profile-label {
        color: rgba(255,255,255,.7);
        font-size: .82rem;
        margin-bottom: 3px;
    }


    .edit-button {
        border-radius: 10px;
        padding: 9px 17px;
        font-weight: 600;
    }


    .profile-body {
        padding: 30px 32px;
    }


    .content-section {
        margin-bottom: 4px;
    }


    .section-heading {
        display: flex;
        align-items: center;
        gap: 12px;
    }


    .section-heading-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #eef4ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }


    .section-divider {
        margin: 30px 0;
        border-color: #e9edf3;
        opacity: 1;
    }


    .career-box {
        padding: 18px 20px;
        background: #f8fafc;
        border: 1px solid #edf0f4;
        border-radius: 12px;
        line-height: 1.7;
    }


    .info-card {
        height: 100%;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px;
        border: 1px solid #edf0f4;
        border-radius: 12px;
        background: #ffffff;
        transition: .2s ease;
    }


        .info-card:hover {
            border-color: #dbe4f0;
            background: #fafcff;
        }


    .info-icon {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #eef4ff;
        color: #2563eb;
        font-size: 16px;
    }


    .info-label {
        display: block;
        color: #64748b;
        font-size: .78rem;
        margin-bottom: 3px;
    }


    .info-value {
        font-size: .94rem;
        font-weight: 600;
        color: #1f2937;
    }


    .preference-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 17px 18px;
        background: #f8fafc;
        border: 1px solid #edf0f4;
        border-radius: 12px;
    }


    .preference-badge {
        background: #eaf1ff;
        color: #2563eb;
        padding: 8px 12px;
        border-radius: 20px;
        font-weight: 600;
    }


    .bottom-actions {
        margin-top: 30px;
        padding-top: 24px;
        border-top: 1px solid #edf0f4;
    }


    .danger-zone {
        margin-top: 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 18px;
        border: 1px solid #fecaca;
        border-radius: 12px;
        background: #fffafa;
    }


    .danger-content {
        display: flex;
        align-items: center;
        gap: 13px;
    }


    .danger-icon {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #fee2e2;
        color: #dc2626;
    }

    .skill-card {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 15px 16px;
        background: #ffffff;
        border: 1px solid #edf0f4;
        border-radius: 12px;
        transition: .2s ease;
    }

        .skill-card:hover {
            border-color: #dbe4f0;
            background: #fafcff;
            box-shadow: 0 4px 14px rgba(15, 23, 42, .04);
        }

    .skill-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .skill-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 10px;
        background: #eef4ff;
        color: #2563eb;
    }

    .skill-name {
        font-size: .94rem;
        color: #1f2937;
    }

    .skill-level {
        display: inline-block;
        margin-top: 4px;
        padding: 3px 9px;
        border-radius: 20px;
        background: #eef4ff;
        color: #2563eb;
        font-size: .72rem;
        font-weight: 600;
    }

    .skill-menu {
        border: 0;
        background: #f8fafc;
        color: #64748b;
        border-radius: 8px;
    }

        .skill-menu:hover {
            background: #eef2f7;
        }

    .empty-skills {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 20px;
        border: 1px dashed #d8e0ea;
        border-radius: 12px;
        background: #fafcff;
    }

    .empty-skill-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 12px;
        background: #eef4ff;
        color: #2563eb;
        font-size: 18px;
    }

    @@media (max-width: 767px) {

        .profile-header {
            padding: 24px;
        }

        .profile-body {
            padding: 24px;
        }

        .danger-zone {
            align-items: stretch;
            flex-direction: column;
        }

            .danger-zone form,
            .danger-zone button {
                width: 100%;
            }

        .preference-card {
            align-items: flex-start;
            flex-direction: column;
        }

        .empty-skills {
            align-items: flex-start;
            flex-direction: column;
        }

        .empty-skills .btn {
            width: 100%;
        }
    }

</style>