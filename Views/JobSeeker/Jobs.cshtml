@model List<JobCareerPlatform.Models.JobPosting>

@{
    Layout = "_JobSeekerLayout";
    ViewData["Title"] = "Jobs";

    var activeJobs = Model?.Count ?? 0;

    var companyCount = Model?
        .Where(j => j.Employer != null && !string.IsNullOrWhiteSpace(j.Employer.FullName))
        .Select(j => j.Employer!.FullName)
        .Distinct()
        .Count() ?? 0;

    var categoryCount = Model?
        .Where(j => j.JobCategory != null)
        .Select(j => j.JobCategory!.CategoryName)
        .Distinct()
        .Count() ?? 0;

    var appliedJobIds =
        ViewBag.AppliedJobIds as List<int>
        ?? new List<int>();

    var searchString =
        ViewBag.SearchString as string
        ?? string.Empty;
}

<div class="py-3">

    <div class="jobs-page">

        <!-- PAGE HEADER -->
        <div class="jobs-header mb-4">

            <div>

                <span class="page-badge">
                    <i class="bi bi-briefcase me-1"></i>
                    Job Opportunities
                </span>

                <h2 class="fw-bold mb-1 mt-2">
                    Find Your Next Opportunity
                </h2>

                <p class="text-muted mb-0">
                    Browse available jobs and search for opportunities
                    that match your interests.
                </p>

            </div>

        </div>


        <!-- SUMMARY CARDS -->
        <div class="row g-3 mb-4">

            <!-- Jobs -->
            <div class="col-md-4">

                <div class="summary-card">

                    <div class="summary-icon">
                        <i class="bi bi-briefcase"></i>
                    </div>

                    <div>

                        <div class="summary-value">
                            @activeJobs
                        </div>

                        <div class="summary-label">

                            @if (!string.IsNullOrWhiteSpace(searchString))
                            {
                                <span>Jobs Found</span>
                            }
                            else
                            {
                                <span>Active Jobs</span>
                            }

                        </div>

                    </div>

                </div>

            </div>


            <!-- Companies -->
            <div class="col-md-4">

                <div class="summary-card">

                    <div class="summary-icon">
                        <i class="bi bi-building"></i>
                    </div>

                    <div>

                        <div class="summary-value">
                            @companyCount
                        </div>

                        <div class="summary-label">
                            Companies
                        </div>

                    </div>

                </div>

            </div>


            <!-- Categories -->
            <div class="col-md-4">

                <div class="summary-card">

                    <div class="summary-icon">
                        <i class="bi bi-grid"></i>
                    </div>

                    <div>

                        <div class="summary-value">
                            @categoryCount
                        </div>

                        <div class="summary-label">
                            Job Categories
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- SEARCH -->
        <div class="filter-card mb-4">

            <div class="filter-heading mb-3">

                <h5 class="fw-bold mb-1">
                    Search Jobs
                </h5>

                <p class="text-muted small mb-0">
                    Search by job title, company, category or location.
                </p>

            </div>


            <form asp-controller="JobSeeker"
                  asp-action="Jobs"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-lg-9">

                        <label class="form-label">
                            Search
                        </label>

                        <div class="input-group search-input">

                            <span class="input-group-text">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   name="searchString"
                                   value="@searchString"
                                   class="form-control"
                                   placeholder="Search job title, company, category or location..." />

                        </div>

                    </div>


                    <div class="col-lg-3">

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary search-button flex-grow-1">

                                <i class="bi bi-search me-1"></i>
                                Search

                            </button>


                            <a asp-controller="JobSeeker"
                               asp-action="Jobs"
                               class="btn btn-outline-secondary clear-button">

                                Clear

                            </a>

                        </div>

                    </div>

                </div>

            </form>


            @if (!string.IsNullOrWhiteSpace(searchString))
            {
                <div class="search-info mt-3">

                    <i class="bi bi-info-circle me-1"></i>

                    Showing results for

                    <strong>
                        "@searchString"
                    </strong>

                </div>
            }

        </div>


        <!-- JOB LIST HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-3">

            <div>

                <h5 class="fw-bold mb-1">
                    Available Jobs
                </h5>

                <div class="text-muted small">

                    @if (!string.IsNullOrWhiteSpace(searchString))
                    {
                        <span>
                            @activeJobs result@(activeJobs == 1 ? "" : "s") found
                        </span>
                    }
                    else
                    {
                        <span>
                            @activeJobs active job@(activeJobs == 1 ? "" : "s") available
                        </span>
                    }

                </div>

            </div>

        </div>


        <!-- JOB LIST -->
        @if (Model != null && Model.Any())
        {
            <div class="row g-4">

                @foreach (var job in Model)
                {
                    var initials = "CO";

                    var employerName = job.Employer?.FullName;

                    if (!string.IsNullOrWhiteSpace(employerName))
                    {
                        var parts = employerName
                        .Split(
                        ' ',
                        StringSplitOptions.RemoveEmptyEntries
                        );

                        if (parts.Length >= 2)
                        {
                            initials =
                            $"{parts[0][0]}{parts[^1][0]}"
                            .ToUpper();
                        }
                        else
                        {
                            initials =
                            parts[0][0]
                            .ToString()
                            .ToUpper();
                        }
                    }


                    <div class="col-xl-6">

                        <div class="job-card">

                            <!-- JOB HEADER -->
                            <div class="job-header">

                                <div class="company-logo">
                                    @initials
                                </div>


                                <div class="flex-grow-1">

                                    <div class="d-flex justify-content-between align-items-start gap-3">

                                        <div>

                                            <h5 class="job-title">
                                                @job.JobTitle
                                            </h5>

                                            <div class="company-name">
                                                @(employerName ?? "Unknown Employer")
                                            </div>

                                        </div>


                                        @if (appliedJobIds.Contains(job.JobId))
                                        {
                                            <span class="applied-badge">

                                                <i class="bi bi-check-circle-fill me-1"></i>

                                                Applied

                                            </span>
                                        }

                                    </div>


                                    <div class="job-meta mt-2">

                                        <span>

                                            <i class="bi bi-geo-alt me-1"></i>

                                            @job.Location

                                        </span>


                                        @if (!string.IsNullOrWhiteSpace(job.EmploymentType))
                                        {
                                            <span class="employment-badge">

                                                <i class="bi bi-briefcase me-1"></i>

                                                @job.EmploymentType

                                            </span>
                                        }


                                        @if (job.JobCategory != null)
                                        {
                                            <span>

                                                <i class="bi bi-grid me-1"></i>

                                                @job.JobCategory.CategoryName

                                            </span>
                                        }

                                    </div>

                                </div>

                            </div>


                            <!-- DESCRIPTION -->
                            @if (!string.IsNullOrWhiteSpace(job.JobDescription))
                            {
                                <div class="job-description mt-3">

                                    @job.JobDescription

                                </div>
                            }


                            <!-- REQUIRED SKILLS -->
                            @if (!string.IsNullOrWhiteSpace(job.RequiredSkills))
                            {
                                <div class="skills-section mt-4">

                                    <div class="section-label mb-2">
                                        Required Skills
                                    </div>


                                    <div class="skill-tags">

                                        @foreach (var skill in job.RequiredSkills.Split(','))
                                        {
                                            <span class="skill-tag">
                                                @skill.Trim()
                                            </span>
                                        }

                                    </div>

                                </div>
                            }


                            <!-- FOOTER -->
                            <div class="job-footer">

                                <div>

                                    <div class="salary-value">

                                        @if (job.SalaryMin.HasValue &&
                                                                        job.SalaryMax.HasValue)
                                        {
                                            <span>

                                                RM @job.SalaryMin.Value.ToString("N0")
                                                –
                                                RM @job.SalaryMax.Value.ToString("N0")

                                            </span>
                                        }
                                        else if (job.SalaryMin.HasValue)
                                        {
                                            <span>

                                                From RM @job.SalaryMin.Value.ToString("N0")

                                            </span>
                                        }
                                        else if (job.SalaryMax.HasValue)
                                        {
                                            <span>

                                                Up to RM @job.SalaryMax.Value.ToString("N0")

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="salary-unspecified">

                                                Salary not specified

                                            </span>
                                        }

                                    </div>


                                    <div class="text-muted small">
                                        Monthly salary
                                    </div>

                                </div>


                                <a asp-controller="JobSeeker"
                                   asp-action="JobDetails"
                                   asp-route-id="@job.JobId"
                                   class="btn btn-outline-primary view-job-button">

                                    View Job

                                    <i class="bi bi-arrow-right ms-1"></i>

                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty-jobs">

                <div class="empty-jobs-icon">

                    @if (!string.IsNullOrWhiteSpace(searchString))
                    {
                        <i class="bi bi-search"></i>
                    }
                    else
                    {
                        <i class="bi bi-briefcase"></i>
                    }

                </div>


                @if (!string.IsNullOrWhiteSpace(searchString))
                {
                    <h5 class="fw-bold mt-3 mb-2">
                        No Matching Jobs Found
                    </h5>

                    <p class="text-muted mb-3">

                        We couldn't find any jobs matching

                        <strong>
                            "@searchString"
                        </strong>.

                    </p>


                    <a asp-controller="JobSeeker"
                       asp-action="Jobs"
                       class="btn btn-outline-primary">

                        <i class="bi bi-arrow-counterclockwise me-1"></i>

                        View All Jobs

                    </a>
                }
                else
                {
                    <h5 class="fw-bold mt-3 mb-2">
                        No Jobs Available
                    </h5>

                    <p class="text-muted mb-0">

                        There are currently no active job opportunities.
                        Please check again later.

                    </p>
                }

            </div>
        }

    </div>

</div>


<style>

    .jobs-page {
        width: 100%;
        max-width: 1450px;
        margin: 0 auto;
    }


    .jobs-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }


    .page-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 11px;
        border-radius: 20px;
        background: #eaf1ff;
        color: #2563eb;
        font-size: .78rem;
        font-weight: 600;
    }


    /* SUMMARY */

    .summary-card {
        display: flex;
        align-items: center;
        gap: 14px;
        height: 100%;
        padding: 18px;
        background: #ffffff;
        border: 1px solid #edf0f4;
        border-radius: 14px;
        box-shadow: 0 3px 12px rgba(15, 23, 42, .03);
    }


    .summary-icon {
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #eef4ff;
        color: #2563eb;
        font-size: 18px;
    }


    .summary-value {
        color: #1e293b;
        font-size: 1.35rem;
        font-weight: 700;
        line-height: 1.1;
    }


    .summary-label {
        margin-top: 3px;
        color: #64748b;
        font-size: .8rem;
    }


    /* SEARCH */

    .filter-card {
        padding: 22px;
        background: white;
        border: 1px solid #edf0f4;
        border-radius: 14px;
        box-shadow: 0 4px 14px rgba(15, 23, 42, .04);
    }


        .filter-card .form-label {
            color: #374151;
            font-size: .82rem;
            font-weight: 600;
        }


    .form-control,
    .input-group-text {
        min-height: 43px;
        border-color: #e2e8f0;
    }


    .input-group-text {
        background: #f8fafc;
        border-radius: 10px 0 0 10px;
        color: #64748b;
    }


    .search-input .form-control {
        border-radius: 0 10px 10px 0;
    }


    .form-control:focus {
        border-color: #93b4fa;
        box-shadow: 0 0 0 .18rem rgba(37, 99, 235, .10);
    }


    .search-button,
    .clear-button {
        min-height: 43px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .85rem;
        font-weight: 600;
    }


    .search-info {
        padding: 9px 12px;
        background: #f8fafc;
        border: 1px solid #edf0f4;
        border-radius: 9px;
        color: #64748b;
        font-size: .78rem;
    }


    /* JOB CARD */

    .job-card {
        height: 100%;
        display: flex;
        flex-direction: column;
        padding: 24px;
        background: white;
        border: 1px solid #e8edf3;
        border-radius: 16px;
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }


        .job-card:hover {
            transform: translateY(-3px);
            border-color: #d5deeb;
            box-shadow: 0 10px 28px rgba(15, 23, 42, .07);
        }


    .job-header {
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }


    .company-logo {
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: linear-gradient( 135deg, #eef4ff, #e4ebff );
        color: #2563eb;
        font-size: .9rem;
        font-weight: 700;
    }


    .job-title {
        margin-bottom: 3px;
        color: #1e293b;
        font-size: 1.05rem;
        font-weight: 700;
    }


    .company-name {
        color: #64748b;
        font-size: .85rem;
    }


    .job-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        color: #64748b;
        font-size: .78rem;
    }


    .employment-badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 8px;
        border-radius: 20px;
        background: #ecfdf5;
        color: #047857;
        font-weight: 600;
    }


    .applied-badge {
        display: inline-flex;
        align-items: center;
        flex-shrink: 0;
        padding: 5px 9px;
        border-radius: 20px;
        background: #ecfdf5;
        color: #047857;
        font-size: .72rem;
        font-weight: 600;
    }


    .job-description {
        display: -webkit-box;
        overflow: hidden;
        color: #475569;
        font-size: .88rem;
        line-height: 1.6;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }


    .section-label {
        color: #64748b;
        font-size: .75rem;
        font-weight: 600;
    }


    .skill-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }


    .skill-tag {
        padding: 5px 9px;
        border-radius: 20px;
        background: #eef4ff;
        color: #2563eb;
        font-size: .72rem;
        font-weight: 600;
    }


    .job-footer {
        margin-top: auto;
        padding-top: 20px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 15px;
        border-top: 1px solid #edf0f4;
    }


    .salary-value {
        color: #2563eb;
        font-size: 1.05rem;
        font-weight: 700;
    }


    .salary-unspecified {
        color: #64748b;
        font-size: .9rem;
        font-weight: 600;
    }


    .view-job-button {
        padding: 8px 15px;
        border-radius: 9px;
        font-size: .85rem;
        font-weight: 600;
    }


    /* EMPTY */

    .empty-jobs {
        padding: 65px 20px;
        text-align: center;
        background: white;
        border: 1px dashed #d8e0ea;
        border-radius: 16px;
    }


    .empty-jobs-icon {
        width: 56px;
        height: 56px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        background: #eef4ff;
        color: #2563eb;
        font-size: 22px;
    }


    /* MOBILE */

    @@media (max-width: 767px) {

        .summary-card {
            padding: 15px;
        }


        .filter-card {
            padding: 18px;
        }


        .job-card {
            padding: 19px;
        }


        .job-footer {
            align-items: stretch;
            flex-direction: column;
        }


        .view-job-button {
            width: 100%;
            padding: 10px;
        }


        .search-button,
        .clear-button {
            flex: 1;
        }
    }

</style>