@model JobCareerPlatform.Models.AssessmentResult

@{
    Layout = "_JobSeekerLayout";
    ViewData["Title"] = "Assessment Result";

    var assessment =
        ViewBag.Assessment as JobCareerPlatform.Models.SkillAssessment;
}

<div class="py-3">

    <div class="result-page">

        <div class="result-card">

            <div class="result-icon @(Model.IsPassed ? "passed" : "failed")">

                @if (Model.IsPassed)
                {
                    <i class="bi bi-check-circle-fill"></i>
                }
                else
                {
                    <i class="bi bi-x-circle-fill"></i>
                }

            </div>

            <div class="text-center">

                <span class="page-badge">
                    Assessment Result
                </span>

                <h2 class="fw-bold mt-3 mb-1">
                    @(assessment?.Title ?? "Skills Assessment")
                </h2>

                <p class="text-muted mb-4">
                    Your assessment has been completed successfully.
                </p>

            </div>


            <div class="score-box">

                <div class="score-label">
                    Your Score
                </div>

                <div class="score-value">
                    @Model.Score%
                </div>

                <div class="score-details">
                    @Model.CorrectAnswers correct out of
                    @Model.TotalQuestions questions
                </div>

            </div>


            <div class="result-status @(Model.IsPassed ? "passed" : "failed")">

                @if (Model.IsPassed)
                {
                    <i class="bi bi-trophy-fill me-2"></i>
                    <span>Passed</span>
                }
                else
                {
                    <i class="bi bi-arrow-repeat me-2"></i>
                    <span>Not Passed</span>
                }

            </div>


            <div class="result-info">

                <div class="info-item">

                    <span class="info-label">
                        Passing Score
                    </span>

                    <strong>
                        @(assessment?.PassingScore ?? 0)%
                    </strong>

                </div>


                <div class="info-item">

                    <span class="info-label">
                        Correct Answers
                    </span>

                    <strong>
                        @Model.CorrectAnswers / @Model.TotalQuestions
                    </strong>

                </div>


                <div class="info-item">

                    <span class="info-label">
                        Completed Date
                    </span>

                    <strong>
                        @Model.CompletedDate.ToString("dd MMM yyyy")
                    </strong>

                </div>

            </div>


            <div class="result-actions">

                <a asp-action="Assessments"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-left me-1"></i>
                    Back to Assessments

                </a>

                @if (assessment != null)
                {
                    <a asp-action="StartAssessment"
                       asp-route-id="@assessment.SkillAssessmentId"
                       class="btn btn-primary">

                        <i class="bi bi-arrow-repeat me-1"></i>
                        Retake Assessment

                    </a>
                }

            </div>

        </div>

    </div>

</div>


<style>

    .result-page {
        width: 100%;
        max-width: 760px;
        margin: 0 auto;
    }

    .result-card {
        padding: 32px;
        background: white;
        border: 1px solid #edf0f4;
        border-radius: 18px;
        box-shadow: 0 5px 20px rgba(15, 23, 42, .05);
    }

    .result-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 30px;
    }

        .result-icon.passed {
            background: #ecfdf5;
            color: #047857;
        }

        .result-icon.failed {
            background: #fef2f2;
            color: #dc2626;
        }

    .page-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 11px;
        border-radius: 20px;
        background: #eef4ff;
        color: #2563eb;
        font-size: .75rem;
        font-weight: 600;
    }

    .score-box {
        padding: 24px;
        text-align: center;
        background: #f8fafc;
        border: 1px solid #edf0f4;
        border-radius: 14px;
        margin-bottom: 18px;
    }

    .score-label {
        color: #64748b;
        font-size: .8rem;
        margin-bottom: 4px;
    }

    .score-value {
        color: #2563eb;
        font-size: 2.5rem;
        font-weight: 800;
        line-height: 1.1;
    }

    .score-details {
        color: #64748b;
        font-size: .8rem;
        margin-top: 7px;
    }

    .result-status {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 11px;
        border-radius: 11px;
        font-size: .9rem;
        font-weight: 700;
        margin-bottom: 20px;
    }

        .result-status.passed {
            background: #ecfdf5;
            color: #047857;
        }

        .result-status.failed {
            background: #fef2f2;
            color: #dc2626;
        }

    .result-info {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-bottom: 24px;
    }

    .info-item {
        padding: 14px;
        text-align: center;
        background: #ffffff;
        border: 1px solid #edf0f4;
        border-radius: 11px;
    }

    .info-label {
        display: block;
        color: #94a3b8;
        font-size: .7rem;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .info-item strong {
        color: #1e293b;
        font-size: .85rem;
    }

    .result-actions {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding-top: 20px;
        border-top: 1px solid #edf0f4;
    }

        .result-actions .btn {
            border-radius: 9px;
            padding: 9px 16px;
            font-size: .85rem;
            font-weight: 600;
        }

    @@media (max-width: 767px) {

        .result-card {
            padding: 22px;
        }

        .result-info {
            grid-template-columns: 1fr;
        }

        .result-actions {
            flex-direction: column-reverse;
        }

            .result-actions .btn {
                width: 100%;
            }
    }

</style>