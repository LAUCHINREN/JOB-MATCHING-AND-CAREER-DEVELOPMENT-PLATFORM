@using Microsoft.AspNetCore.Identity
@using JobCareerPlatform.Data
@inject UserManager<ApplicationUser> UserManager

@{
    Layout = "_JobSeekerLayout";
    ViewData["Title"] = "Job Seeker Dashboard";

    var currentUser = await UserManager.GetUserAsync(User);

    var recommendedJobs =
        ViewBag.RecommendedJobs
        as List<JobCareerPlatform.Models.JobPosting>;

    var recommendationScores =
        ViewBag.RecommendationScores
        as Dictionary<int, int>
        ?? new Dictionary<int, int>();

    int profileCompletion =
        ViewBag.ProfileCompletion ?? 0;

    int applicationCount =
        ViewBag.ApplicationCount ?? 0;
}

<div class="dashboard-page py-3">

    <!-- ========================= -->
    <!-- WELCOME HEADER -->
    <!-- ========================= -->

    <div class="welcome-header mb-4">

        <div>
            <p class="text-muted mb-1">
                Welcome back
            </p>

            <h2 class="fw-bold mb-1">
                Hello, @(currentUser?.FullName ?? "Job Seeker")
            </h2>

            <p class="text-muted mb-0">
                Manage your profile, explore opportunities
                and track your career progress.
            </p>
        </div>

        @if (profileCompletion < 100)
        {
            <div class="mt-3 mt-md-0">

                <a asp-controller="JobSeeker"
                   asp-action="Profile"
                   class="btn btn-primary profile-button">

                    <i class="bi bi-person-check me-1"></i>
                    Complete Profile

                </a>

            </div>
        }

    </div>


    <!-- ========================= -->
    <!-- SUMMARY CARDS -->
    <!-- ========================= -->

    <div class="row g-3 mb-4">

        <!-- PROFILE -->
        <div class="col-sm-6 col-xl-3">

            <div class="summary-card">

                <div class="d-flex justify-content-between align-items-start mb-3">

                    <div>
                        <div class="summary-label">
                            Profile Completion
                        </div>

                        <div class="summary-number">
                            @profileCompletion%
                        </div>
                    </div>

                    <div class="summary-icon">
                        <i class="bi bi-person"></i>
                    </div>

                </div>

                <div class="progress profile-progress">

                    <div class="progress-bar"
                         role="progressbar"
                         style="width: @profileCompletion%">
                    </div>

                </div>

                <a asp-controller="JobSeeker"
                   asp-action="Profile"
                   class="summary-link">

                    @if (profileCompletion < 100)
                    {
                        <span>
                            Complete your profile
                        </span>
                    }
                    else
                    {
                        <span>
                            View career profile
                        </span>
                    }

                    <i class="bi bi-arrow-right ms-1"></i>

                </a>

            </div>

        </div>


        <!-- AVAILABLE JOBS -->
        <div class="col-sm-6 col-xl-3">

            <div class="summary-card">

                <div class="d-flex justify-content-between align-items-start mb-3">

                    <div>

                        <div class="summary-label">
                            Available Jobs
                        </div>

                        <div class="summary-number">
                            @ViewBag.TotalJobCount
                        </div>

                    </div>

                    <div class="summary-icon">
                        <i class="bi bi-briefcase"></i>
                    </div>

                </div>

                <p class="summary-description">
                    Browse all available job opportunities
                    that match your career interests.
                </p>

                <a asp-controller="JobSeeker"
                   asp-action="Jobs"
                   class="summary-link">

                    View jobs

                    <i class="bi bi-arrow-right ms-1"></i>

                </a>

            </div>

        </div>


        <!-- APPLICATIONS -->
        <div class="col-sm-6 col-xl-3">

            <div class="summary-card">

                <div class="d-flex justify-content-between align-items-start mb-3">

                    <div>
                        <div class="summary-label">
                            Applications
                        </div>

                        <div class="summary-number">
                            @applicationCount
                        </div>
                    </div>

                    <div class="summary-icon">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>

                </div>

                <p class="summary-description">
                    Track your submitted applications
                    and current progress.
                </p>

                <a asp-controller="JobSeeker"
                   asp-action="Applications"
                   class="summary-link">

                    Track applications

                    <i class="bi bi-arrow-right ms-1"></i>

                </a>

            </div>

        </div>


        <!-- ASSESSMENTS -->
        <div class="col-sm-6 col-xl-3">

            <div class="summary-card">

                <div class="d-flex justify-content-between align-items-start mb-3">

                    <div>
                        <div class="summary-label">
                            Assessments
                        </div>

                        <div class="summary-number">
                            @ViewBag.AssessmentCount
                        </div>
                    </div>

                    <div class="summary-icon">
                        <i class="bi bi-clipboard-check"></i>
                    </div>

                </div>

                <p class="summary-description">
                    Complete skills assessments
                    and review your results.
                </p>

                <a asp-controller="JobSeeker"
                   asp-action="Assessments"
                   class="summary-link">

                    Take an assessment

                    <i class="bi bi-arrow-right ms-1"></i>

                </a>

            </div>

        </div>

    </div>


    <!-- ========================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================= -->

    <div class="row g-4">

        <!-- ========================= -->
        <!-- RECOMMENDED JOBS -->
        <!-- ========================= -->

        <div class="col-lg-8">

            <div class="card main-card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="section-header">

                        <div class="section-title-area">

                            <div class="section-icon">
                                <i class="bi bi-stars"></i>
                            </div>

                            <div>
                                <h4 class="fw-bold mb-1">
                                    Recommended Jobs
                                </h4>

                                <p class="text-muted small mb-0">
                                    Opportunities selected based on your
                                    profile, preferences and skills.
                                </p>
                            </div>

                        </div>

                        <a asp-controller="JobSeeker"
                           asp-action="Jobs"
                           class="btn btn-outline-primary btn-sm view-all-button">

                            View All Jobs

                            <i class="bi bi-arrow-right ms-1"></i>

                        </a>

                    </div>


                    @if (recommendedJobs != null &&
                                        recommendedJobs.Any())
                    {
                        <div class="recommended-list">

                            @foreach (var job in recommendedJobs)
                            {
                                var score =
                                recommendationScores.ContainsKey(job.JobId)
                                ? recommendationScores[job.JobId]
                                : 0;

                                var companyInitials = "CO";

                                var employerName = job.Employer?.FullName;

                                if (!string.IsNullOrWhiteSpace(employerName))
                                {
                                    var parts = employerName
                                    .Split(
                                    ' ',
                                    StringSplitOptions.RemoveEmptyEntries
                                    );

                                    if (parts.Length >= 2)
                                    {
                                        companyInitials =
                                        $"{parts[0][0]}{parts[^1][0]}"
                                        .ToUpper();
                                    }
                                    else
                                    {
                                        companyInitials =
                                        parts[0][0]
                                        .ToString()
                                        .ToUpper();
                                    }
                                }

                                <div class="recommended-job">

                                    <div class="recommended-logo">
                                        @companyInitials
                                    </div>

                                    <div class="flex-grow-1">

                                        <div class="d-flex
                                                            justify-content-between
                                                            align-items-start
                                                            gap-3">

                                            <div>

                                                <h6 class="job-title mb-1">
                                                    @job.JobTitle
                                                </h6>

                                                <div class="company-name">
                                                    @(employerName ?? "Unknown Employer")
                                                </div>

                                            </div>

                                            <span class="match-badge">

                                                <i class="bi bi-stars me-1"></i>

                                                @score% Match

                                            </span>

                                        </div>


                                        <div class="recommended-meta mt-2">

                                            <span>
                                                <i class="bi bi-geo-alt me-1"></i>
                                                @job.Location
                                            </span>

                                            @if (!string.IsNullOrWhiteSpace(job.EmploymentType))
                                            {
                                                <span>
                                                    <i class="bi bi-briefcase me-1"></i>
                                                    @job.EmploymentType
                                                </span>
                                            }

                                        </div>


                                        @if (!string.IsNullOrWhiteSpace(job.RequiredSkills))
                                        {
                                            <div class="recommended-skills mt-3">

                                                @foreach (var skill in job.RequiredSkills
                                                                                    .Split(',')
                                                                                    .Take(4))
                                                {
                                                    <span>
                                                        @skill.Trim()
                                                    </span>
                                                }

                                            </div>
                                        }


                                        <div class="recommended-footer mt-3">

                                            <div>

                                                @if (job.SalaryMin.HasValue &&
                                                                                        job.SalaryMax.HasValue)
                                                {
                                                    <span class="salary-text">

                                                        RM @job.SalaryMin.Value.ToString("N0")
                                                        –
                                                        RM @job.SalaryMax.Value.ToString("N0")

                                                    </span>
                                                }

                                            </div>

                                            <a asp-controller="JobSeeker"
                                               asp-action="JobDetails"
                                               asp-route-id="@job.JobId"
                                               class="btn btn-outline-primary btn-sm">

                                                View Job

                                                <i class="bi bi-arrow-right ms-1"></i>

                                            </a>

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="empty-recommendations">

                            <div class="empty-recommendation-icon">
                                <i class="bi bi-stars"></i>
                            </div>

                            <h5 class="fw-semibold mt-3 mb-2">
                                No recommendations yet
                            </h5>


                            @if (profileCompletion < 100)
                            {
                                <p class="text-muted mb-3">

                                    Complete your skills and career preferences
                                    to receive personalised job recommendations.

                                </p>

                                <a asp-controller="JobSeeker"
                                   asp-action="Profile"
                                   class="btn btn-primary">

                                    <i class="bi bi-person me-1"></i>
                                    Complete Profile

                                </a>
                            }
                            else
                            {
                                <p class="text-muted mb-0">

                                    Your profile is complete, but there are
                                    currently no suitable job recommendations available.

                                </p>
                            }

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- ========================= -->
        <!-- QUICK ACTIONS -->
        <!-- ========================= -->

        <div class="col-lg-4">

            <div class="card main-card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="section-title-area mb-4">

                        <div class="section-icon">
                            <i class="bi bi-lightning-charge"></i>
                        </div>

                        <div>

                            <h4 class="fw-bold mb-1">
                                Quick Actions
                            </h4>

                            <p class="text-muted small mb-0">
                                Access your most important features.
                            </p>

                        </div>

                    </div>


                    <div class="d-grid gap-3">

                        <!-- PROFILE -->
                        <a asp-controller="JobSeeker"
                           asp-action="Profile"
                           class="quick-action">

                            <span class="quick-action-icon">
                                <i class="bi bi-person"></i>
                            </span>

                            <span class="flex-grow-1">

                                <strong>
                                    Manage Profile
                                </strong>

                                <small>
                                    Education, preferences and skills
                                </small>

                            </span>

                            <i class="bi bi-chevron-right quick-arrow"></i>

                        </a>


                        <!-- JOBS -->
                        <a asp-controller="JobSeeker"
                           asp-action="Jobs"
                           class="quick-action">

                            <span class="quick-action-icon">
                                <i class="bi bi-search"></i>
                            </span>

                            <span class="flex-grow-1">

                                <strong>
                                    Browse Jobs
                                </strong>

                                <small>
                                    Explore available opportunities
                                </small>

                            </span>

                            <i class="bi bi-chevron-right quick-arrow"></i>

                        </a>

                        <!-- APPLICATIONS -->
                        <a asp-controller="JobSeeker"
                           asp-action="Applications"
                           class="quick-action">

                            <span class="quick-action-icon">
                                <i class="bi bi-file-earmark-text"></i>
                            </span>

                            <span class="flex-grow-1">

                                <strong>
                                    My Applications
                                </strong>

                                <small>
                                    Track application progress
                                </small>

                            </span>

                            <i class="bi bi-chevron-right quick-arrow"></i>

                        </a>


                        <!-- ASSESSMENTS -->
                        <a asp-controller="JobSeeker"
                           asp-action="Assessments"
                           class="quick-action">

                            <span class="quick-action-icon">
                                <i class="bi bi-clipboard-check"></i>
                            </span>

                            <span class="flex-grow-1">

                                <strong>
                                    Skills Assessment
                                </strong>

                                <small>
                                    Test and improve your skills
                                </small>

                            </span>

                            <i class="bi bi-chevron-right quick-arrow"></i>

                        </a>


                        <!-- CAREER GUIDANCE -->
                        <a asp-controller="JobSeeker"
                           asp-action="CareerResources"
                           class="quick-action">

                            <span class="quick-action-icon">
                                <i class="bi bi-mortarboard"></i>
                            </span>

                            <span class="flex-grow-1">

                                <strong>
                                    Career Guidance
                                </strong>

                                <small>
                                    Resources, recommendations &amp; counselling
                                </small>

                            </span>

                            <i class="bi bi-chevron-right quick-arrow"></i>

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    .dashboard-page {
        width: 100%;
        max-width: 1500px;
        margin: 0 auto;
    }


    .welcome-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }


    .profile-button {
        border-radius: 10px;
        padding: 9px 17px;
        font-size: .88rem;
        font-weight: 600;
    }


    .summary-card {
        height: 100%;
        padding: 20px;
        background: white;
        border: 1px solid #edf0f4;
        border-radius: 15px;
        box-shadow: 0 3px 12px rgba(15, 23, 42, .03);
        transition: transform .2s ease, box-shadow .2s ease;
    }


        .summary-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(15, 23, 42, .06);
        }


    .summary-label {
        color: #64748b;
        font-size: .82rem;
        margin-bottom: 3px;
    }


    .summary-number {
        color: #1e293b;
        font-size: 1.55rem;
        font-weight: 700;
    }


    .summary-description {
        min-height: 40px;
        color: #64748b;
        font-size: .78rem;
        margin-bottom: 14px;
    }


    .summary-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: #eef4ff;
        color: #2563eb;
        font-size: 17px;
    }


    .summary-link {
        color: #2563eb;
        text-decoration: none;
        font-size: .78rem;
        font-weight: 600;
    }


        .summary-link:hover {
            text-decoration: underline;
        }


    .profile-progress {
        height: 6px;
        margin-top: 4px;
        margin-bottom: 14px;
        border-radius: 20px;
        background: #edf2f7;
    }


        .profile-progress .progress-bar {
            border-radius: 20px;
        }


    .main-card {
        border-radius: 16px !important;
    }


    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 22px;
    }


    .section-title-area {
        display: flex;
        align-items: center;
        gap: 12px;
    }


    .section-icon {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #eef4ff;
        color: #2563eb;
        font-size: 16px;
    }


    .view-all-button {
        border-radius: 8px;
        font-size: .78rem;
        font-weight: 600;
    }


    .recommended-list {
        display: flex;
        flex-direction: column;
        gap: 13px;
    }


    .recommended-job {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 16px;
        border: 1px solid #edf0f4;
        border-radius: 13px;
        background: #ffffff;
        transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
    }


        .recommended-job:hover {
            transform: translateY(-1px);
            border-color: #d8e1ee;
            box-shadow: 0 5px 15px rgba(15, 23, 42, .045);
        }


    .recommended-logo {
        width: 45px;
        height: 45px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: linear-gradient( 135deg, #eef4ff, #e4ebff );
        color: #2563eb;
        font-size: .82rem;
        font-weight: 700;
    }


    .job-title {
        color: #1e293b;
        font-size: .95rem;
        font-weight: 700;
    }


    .company-name {
        color: #64748b;
        font-size: .78rem;
    }


    .match-badge {
        display: inline-flex;
        align-items: center;
        flex-shrink: 0;
        padding: 5px 9px;
        border-radius: 20px;
        background: #ecfdf5;
        color: #047857;
        font-size: .7rem;
        font-weight: 600;
    }


    .recommended-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 13px;
        color: #64748b;
        font-size: .73rem;
    }


    .recommended-skills {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }


        .recommended-skills span {
            padding: 4px 8px;
            border-radius: 20px;
            background: #eef4ff;
            color: #2563eb;
            font-size: .67rem;
            font-weight: 600;
        }


    .recommended-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }


    .salary-text {
        color: #2563eb;
        font-size: .78rem;
        font-weight: 700;
    }


    .empty-recommendations {
        padding: 45px 20px;
        text-align: center;
    }


        .empty-recommendations p {
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }


    .empty-recommendation-icon {
        width: 52px;
        height: 52px;
        margin: auto;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: #eef4ff;
        color: #2563eb;
        font-size: 21px;
    }


    .quick-action {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 13px 14px;
        border: 1px solid #edf0f4;
        border-radius: 12px;
        background: white;
        color: inherit;
        text-decoration: none;
        transition: transform .2s ease, background .2s ease, border-color .2s ease;
    }


        .quick-action:hover {
            transform: translateX(3px);
            border-color: #cfdcf1;
            background: #fafcff;
        }


    .quick-action-icon {
        width: 39px;
        height: 39px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #eef4ff;
        color: #2563eb;
        font-size: 15px;
    }


    .quick-action strong {
        display: block;
        color: #1e293b;
        font-size: .87rem;
    }


    .quick-action small {
        display: block;
        margin-top: 2px;
        color: #64748b;
        font-size: .7rem;
    }


    .quick-arrow {
        color: #94a3b8;
        font-size: .75rem;
    }


    @@media (max-width: 767px) {

        .welcome-header {
            align-items: flex-start;
            flex-direction: column;
        }


        .profile-button {
            width: 100%;
        }


        .section-header {
            align-items: flex-start;
        }


        .recommended-job {
            align-items: flex-start;
        }


        .recommended-footer {
            align-items: flex-start;
            flex-direction: column;
        }


            .recommended-footer .btn {
                width: 100%;
            }
    }

</style>