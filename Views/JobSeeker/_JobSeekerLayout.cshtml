@using Microsoft.AspNetCore.Identity
@using JobCareerPlatform.Data
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var currentUser = await UserManager.GetUserAsync(User);

    var initials = "JS";

    if (!string.IsNullOrWhiteSpace(currentUser?.FullName))
    {
        var parts = currentUser.FullName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
        {
            initials = $"{parts[0][0]}{parts[^1][0]}".ToUpper();
        }
        else
        {
            initials = parts[0][0].ToString().ToUpper();
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CareerConnect</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        body {
            background: #f6f8fb;
            color: #1f2937;
        }

        .job-navbar {
            background: white;
            border-bottom: 1px solid #e5e7eb;
            padding: 7px 0;
        }

        .nav-wrapper {
            width: 96%;
            max-width: 1650px;
            margin: auto;
        }

        .brand-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: #2563eb;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
        }

        .brand-name {
            font-size: 1.05rem;
            font-weight: 700;
            color: #111827;
        }

        .navbar-nav .nav-link {
            color: #64748b;
            font-size: .9rem;
            font-weight: 500;
            padding: 7px 10px !important;
            border-radius: 8px;
            margin-right: 2px;
        }

            .navbar-nav .nav-link:hover {
                background: #f1f5f9;
                color: #2563eb;
            }

            .navbar-nav .nav-link.active {
                background: #eef4ff;
                color: #2563eb;
                font-weight: 600;
            }

        .user-dropdown-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            border: 0;
            background: transparent;
            padding: 5px 8px;
            border-radius: 10px;
            color: #374151;
        }

            .user-dropdown-btn:hover,
            .user-dropdown-btn:focus {
                background: #f1f5f9;
            }

        .user-avatar {
            width: 33px;
            height: 33px;
            border-radius: 50%;
            background: #eaf1ff;
            color: #2563eb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .78rem;
            font-weight: 700;
        }

        .user-display-name {
            font-size: .88rem;
            font-weight: 600;
        }

        .account-menu {
            min-width: 235px;
            border: 1px solid #edf0f4;
            border-radius: 12px;
            padding: 7px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, .09);
        }

            .account-menu .dropdown-item {
                border-radius: 8px;
                padding: 9px 11px;
                font-size: .9rem;
            }

                .account-menu .dropdown-item:hover {
                    background: #f4f7fb;
                }

        .page-wrapper {
            width: 96%;
            max-width: 1650px;
            margin: 20px auto 40px;
        }

        @@media (max-width: 991px) {
            .page-wrapper {
                width: 94%;
            }

            .navbar-nav {
                margin-top: 12px;
                margin-bottom: 10px;
            }

            .user-area {
                padding-top: 10px;
                border-top: 1px solid #e5e7eb;
            }
        }
    </style>
</head>

<body>

    <nav class="navbar navbar-expand-lg job-navbar sticky-top">
        <div class="nav-wrapper d-flex align-items-center">

            <!-- Logo -->
            <a class="navbar-brand d-flex align-items-center me-4"
               asp-controller="JobSeeker"
               asp-action="Home">

                <div class="brand-icon">
                    <i class="bi bi-briefcase-fill"></i>
                </div>

                <span class="brand-name ms-2">
                    CareerConnect
                </span>
            </a>

            <!-- Mobile Menu -->
            <button class="navbar-toggler ms-auto border-0"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#jobMenu"
                    aria-controls="jobMenu"
                    aria-expanded="false">

                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse"
                 id="jobMenu">

                <!-- Navigation -->
                <ul class="navbar-nav">

                    <li class="nav-item">
                        <a class="nav-link @(action == "Home" ? "active" : "")"
                           asp-controller="JobSeeker"
                           asp-action="Home">

                            <i class="bi bi-grid me-1"></i>
                            Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(action == "Profile" ||
                                                                       action == "CreateProfile" ||
                                                                       action == "EditProfile"
                                                                       ? "active" : "")"
                           asp-controller="JobSeeker"
                           asp-action="Profile">

                            <i class="bi bi-person me-1"></i>
                            Career Profile
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(action == "Jobs" ? "active" : "")"
                           asp-controller="JobSeeker"
                           asp-action="Jobs">

                            <i class="bi bi-briefcase me-1"></i>
                            Jobs
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(action == "Applications" ? "active" : "")"
                           asp-controller="JobSeeker"
                           asp-action="Applications">

                            <i class="bi bi-file-earmark-text me-1"></i>
                            Applications
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(action == "Assessments" ? "active" : "")"
                           asp-controller="JobSeeker"
                           asp-action="Assessments">

                            <i class="bi bi-clipboard-check me-1"></i>
                            Assessments
                        </a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle @(action == "CareerResources" ||
                                                                       action == "MyRecommendations" ||
                                                                       action == "MyCounsellingSessions" ||
                                                                       action == "RequestCounsellingSession"
                                                                       ? "active" : "")"
                           href="#"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">

                            <i class="bi bi-mortarboard me-1"></i>
                            Career Guidance
                        </a>
                        <ul class="dropdown-menu account-menu">
                            <li>
                                <a class="dropdown-item @(action == "CareerResources" ? "active" : "")"
                                   asp-controller="JobSeeker"
                                   asp-action="CareerResources">
                                    <i class="bi bi-journal-bookmark me-2"></i>
                                    Resources
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item @(action == "MyRecommendations" ? "active" : "")"
                                   asp-controller="JobSeeker"
                                   asp-action="MyRecommendations">
                                    <i class="bi bi-stars me-2"></i>
                                    Recommended For You
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item @(action == "MyCounsellingSessions" || action == "RequestCounsellingSession" ? "active" : "")"
                                   asp-controller="JobSeeker"
                                   asp-action="MyCounsellingSessions">
                                    <i class="bi bi-calendar2-week me-2"></i>
                                    Counselling Sessions
                                </a>
                            </li>
                        </ul>
                    </li>

                </ul>

                <!-- User Menu -->
                <div class="dropdown ms-auto user-area">

                    <button class="user-dropdown-btn dropdown-toggle"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">

                        <div class="user-avatar">
                            @initials
                        </div>

                        <span class="user-display-name d-none d-md-inline">
                            @(currentUser?.FullName ?? "Job Seeker")
                        </span>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end account-menu mt-2">

                        <li class="px-3 py-2">
                            <div class="fw-semibold">
                                @(currentUser?.FullName ?? "Job Seeker")
                            </div>

                            <div class="text-muted small">
                                @currentUser?.Email
                            </div>
                        </li>

                        <li>
                            <hr class="dropdown-divider" />
                        </li>

                        <li>
                            <a class="dropdown-item"
                               asp-area="Identity"
                               asp-page="/Account/Manage/Index">

                                <i class="bi bi-person-circle me-2"></i>
                                My Account
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item"
                               asp-area="Identity"
                               asp-page="/Account/Manage/ChangePassword">

                                <i class="bi bi-key me-2"></i>
                                Change Password
                            </a>
                        </li>

                        <li>
                            <hr class="dropdown-divider" />
                        </li>

                        <li>
                            <form asp-area="Identity"
                                  asp-page="/Account/Logout"
                                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                                  method="post">

                                <button type="submit"
                                        class="dropdown-item text-danger">

                                    <i class="bi bi-box-arrow-right me-2"></i>
                                    Logout
                                </button>
                            </form>
                        </li>

                    </ul>

                </div>

            </div>
        </div>
    </nav>

    <main class="page-wrapper">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>