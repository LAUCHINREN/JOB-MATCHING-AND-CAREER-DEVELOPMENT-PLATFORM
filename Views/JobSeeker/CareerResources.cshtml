@model List<JobCareerPlatform.Models.CareerResource>

@{
    Layout = "_JobSeekerLayout";
    ViewData["Title"] = "Career Guidance Resources";
}

<div class="py-3" style="width:100%;max-width:1400px;margin:0 auto;">

    <div class="mb-4">
        <span class="badge rounded-pill" style="background:#eaf1ff;color:#2563eb;">
            <i class="bi bi-mortarboard me-1"></i> Career Guidance
        </span>
        <h2 class="fw-bold mb-1 mt-2">Career Resources</h2>
        <p class="text-muted mb-0">Guides, articles, videos, and interview preparation materials published by our career advisors.</p>
    </div>

    <partial name="_CareerGuidanceSubNav" />

    @if (!Model.Any())
    {
        <div class="text-center border rounded-4 p-5 text-muted" style="border-style:dashed !important;">
            No career resources have been published yet. Check back soon.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var resource in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4">
                        <div class="card-body">
                            <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis mb-2">@resource.ResourceType</span>
                            <h5 class="card-title">@resource.Title</h5>
                            <p class="card-text text-muted small">@resource.Description</p>
                        </div>
                        <div class="card-footer bg-white border-0 pb-3">
                            @if (!string.IsNullOrWhiteSpace(resource.ContentUrl))
                            {
                                <a href="@resource.ContentUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary btn-sm rounded-pill">Open Resource</a>
                            }
                            <span class="text-muted small ms-2">@resource.PublishedAt?.ToString("d MMM yyyy")</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
