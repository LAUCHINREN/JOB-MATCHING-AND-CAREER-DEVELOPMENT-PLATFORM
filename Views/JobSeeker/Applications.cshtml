@model List<JobCareerPlatform.Models.JobApplication>

@{
    Layout = "_JobSeekerLayout";
    ViewData["Title"] = "My Applications";

    var jobs = ViewBag.Jobs as Dictionary<int, JobCareerPlatform.Models.JobPosting>;

    var totalApplications = Model?.Count ?? 0;

    var submittedCount = Model?
        .Count(a => a.Status == "Submitted") ?? 0;

    var reviewCount = Model?
        .Count(a => a.Status == "Under Review") ?? 0;

    var shortlistedCount = Model?
        .Count(a => a.Status == "Shortlisted") ?? 0;
}

<div class="py-3">

    <div class="applications-page">

        <!-- ========================= -->
        <!-- SUCCESS / ERROR MESSAGE -->
        <!-- ========================= -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm"
                 role="alert">

                <i class="bi bi-check-circle-fill me-2"></i>

                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm"
                 role="alert">

                <i class="bi bi-exclamation-circle-fill me-2"></i>

                @TempData["ErrorMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }


        <!-- ========================= -->
        <!-- HEADER -->
        <!-- ========================= -->

        <div class="applications-header mb-4">

            <div>

                <span class="page-badge">
                    <i class="bi bi-file-earmark-text me-1"></i>
                    Application Tracking
                </span>

                <h2 class="fw-bold mb-1 mt-2">
                    My Applications
                </h2>

                <p class="text-muted mb-0">
                    Track your submitted job applications and monitor their current status.
                </p>

            </div>


            <a asp-action="Jobs"
               class="btn btn-primary browse-button">

                <i class="bi bi-search me-1"></i>
                Browse Jobs

            </a>

        </div>


        <!-- ========================= -->
        <!-- SUMMARY -->
        <!-- ========================= -->

        <div class="row g-3 mb-4">

            <!-- Total -->
            <div class="col-sm-6 col-xl-3">

                <div class="summary-card">

                    <div class="summary-icon">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>

                    <div>
                        <div class="summary-value">
                            @totalApplications
                        </div>

                        <div class="summary-label">
                            Total Applications
                        </div>
                    </div>

                </div>

            </div>


            <!-- Submitted -->
            <div class="col-sm-6 col-xl-3">

                <div class="summary-card">

                    <div class="summary-icon submitted">
                        <i class="bi bi-send"></i>
                    </div>

                    <div>
                        <div class="summary-value">
                            @submittedCount
                        </div>

                        <div class="summary-label">
                            Submitted
                        </div>
                    </div>

                </div>

            </div>


            <!-- Under Review -->
            <div class="col-sm-6 col-xl-3">

                <div class="summary-card">

                    <div class="summary-icon review">
                        <i class="bi bi-hourglass-split"></i>
                    </div>

                    <div>
                        <div class="summary-value">
                            @reviewCount
                        </div>

                        <div class="summary-label">
                            Under Review
                        </div>
                    </div>

                </div>

            </div>


            <!-- Shortlisted -->
            <div class="col-sm-6 col-xl-3">

                <div class="summary-card">

                    <div class="summary-icon shortlisted">
                        <i class="bi bi-star"></i>
                    </div>

                    <div>
                        <div class="summary-value">
                            @shortlistedCount
                        </div>

                        <div class="summary-label">
                            Shortlisted
                        </div>
                    </div>

                </div>

            </div>

        </div>


        <!-- ========================= -->
        <!-- APPLICATION LIST -->
        <!-- ========================= -->

        <div class="d-flex justify-content-between
                    align-items-center mb-3">

            <div>
                <h5 class="fw-bold mb-1">
                    Application History
                </h5>

                <div class="text-muted small">
                    Your most recent applications appear first.
                </div>
            </div>

        </div>


        @if (Model != null && Model.Any())
        {
            <div class="application-list">

                @foreach (var application in Model)
                {
                    JobCareerPlatform.Models.JobPosting? job = null;

                    if (jobs != null)
                    {
                        jobs.TryGetValue(
                        application.JobId,
                        out job
                        );
                    }


                    var statusClass = "status-submitted";
                    var statusIcon = "bi-send";

                    switch (application.Status)
                    {
                        case "Under Review":
                            statusClass = "status-review";
                            statusIcon = "bi-hourglass-split";
                            break;

                        case "Shortlisted":
                            statusClass = "status-shortlisted";
                            statusIcon = "bi-star";
                            break;

                        case "Accepted":
                            statusClass = "status-accepted";
                            statusIcon = "bi-check-circle";
                            break;

                        case "Rejected":
                            statusClass = "status-rejected";
                            statusIcon = "bi-x-circle";
                            break;

                        case "Withdrawn":
                            statusClass = "status-withdrawn";
                            statusIcon = "bi-arrow-counterclockwise";
                            break;
                    }


                    var companyInitials = "CO";

                    var employerName = job?.Employer?.FullName;

                    if (!string.IsNullOrWhiteSpace(employerName))
                    {
                        var parts = employerName
                        .Split(
                        ' ',
                        StringSplitOptions.RemoveEmptyEntries
                        );

                        if (parts.Length >= 2)
                        {
                            companyInitials =
                            $"{parts[0][0]}{parts[^1][0]}"
                            .ToUpper();
                        }
                        else
                        {
                            companyInitials =
                            parts[0][0]
                            .ToString()
                            .ToUpper();
                        }
                    }


                    <div class="application-card">

                        <!-- Company -->
                        <div class="company-logo">
                            @companyInitials
                        </div>


                        <!-- Main information -->
                        <div class="application-content">

                            <div class="d-flex flex-column flex-md-row
                                                justify-content-between
                                                align-items-md-start
                                                gap-3">

                                <div>

                                    <h5 class="job-title mb-1">

                                        @(job?.JobTitle ?? "Job no longer available")

                                    </h5>


                                    <div class="company-name">

                                        @(employerName ?? "Company unavailable")

                                    </div>


                                    @if (job != null)
                                    {
                                        <div class="job-meta mt-2">

                                            <span>
                                                <i class="bi bi-geo-alt me-1"></i>
                                                @job.Location
                                            </span>

                                            @if (!string.IsNullOrWhiteSpace(job.EmploymentType))
                                            {
                                                <span>
                                                    <i class="bi bi-briefcase me-1"></i>
                                                    @job.EmploymentType
                                                </span>
                                            }

                                        </div>
                                    }

                                </div>


                                <!-- Status -->
                                <span class="status-badge @statusClass">

                                    <i class="bi @statusIcon me-1"></i>

                                    @application.Status

                                </span>

                            </div>


                            <!-- Application details -->
                            <div class="application-details">

                                <div>

                                    <span class="detail-label">
                                        Applied Date
                                    </span>

                                    <div class="detail-value">
                                        <i class="bi bi-calendar3 me-1"></i>
                                        @application.AppliedDate.ToString("dd MMM yyyy")
                                    </div>

                                </div>


                                <div>

                                    <span class="detail-label">
                                        Application ID
                                    </span>

                                    <div class="detail-value">

                                        #@application.JobApplicationId

                                    </div>

                                </div>

                            </div>


                            <!-- Cover Message -->
                            @if (!string.IsNullOrWhiteSpace(application.CoverMessage))
                            {
                                <div class="cover-message">

                                    <div class="cover-label">
                                        <i class="bi bi-chat-left-text me-1"></i>
                                        Cover Message
                                    </div>

                                    <div class="cover-text">
                                        @application.CoverMessage
                                    </div>

                                </div>
                            }


                            <!-- Buttons -->
                            <div class="application-actions">

                                @if (job != null)
                                {
                                    <a asp-action="JobDetails"
                                       asp-route-id="@job.JobId"
                                       class="btn btn-outline-primary btn-sm">

                                        <i class="bi bi-eye me-1"></i>
                                        View Job

                                    </a>
                                }


                                @if (application.Status == "Submitted")
                                {
                                    <a asp-action="EditApplication"
                                       asp-route-id="@application.JobApplicationId"
                                       class="btn btn-outline-secondary btn-sm">

                                        <i class="bi bi-pencil me-1"></i>
                                        Edit Application

                                    </a>


                                    <form asp-action="WithdrawApplication"
                                          asp-route-id="@application.JobApplicationId"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to withdraw this application?');">

                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm">

                                            <i class="bi bi-x-circle me-1"></i>
                                            Withdraw

                                        </button>

                                    </form>
                                }
                                else if (application.Status == "Under Review")
                                {
                                    <span class="action-note">

                                        <i class="bi bi-info-circle me-1"></i>

                                        This application is currently being reviewed.

                                    </span>
                                }
                                else if (application.Status == "Shortlisted")
                                {
                                    <span class="action-note shortlisted-note">

                                        <i class="bi bi-star-fill me-1"></i>

                                        You have been shortlisted.

                                    </span>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <!-- ========================= -->
            <!-- EMPTY STATE -->
            <!-- ========================= -->

            <div class="empty-applications">

                <div class="empty-icon">
                    <i class="bi bi-file-earmark-text"></i>
                </div>

                <h5 class="fw-bold mt-3 mb-2">
                    No Applications Yet
                </h5>

                <p class="text-muted mb-4">
                    You haven't applied for any jobs yet.
                    Browse available opportunities and start your career journey.
                </p>

                <a asp-action="Jobs"
                   class="btn btn-primary px-4">

                    <i class="bi bi-search me-1"></i>
                    Browse Jobs

                </a>

            </div>
        }

    </div>

</div>


<style>

    .applications-page {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
    }


    .applications-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
    }


    .page-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 11px;
        border-radius: 20px;
        background: #eaf1ff;
        color: #2563eb;
        font-size: .78rem;
        font-weight: 600;
    }


    .browse-button {
        border-radius: 10px;
        padding: 9px 16px;
        font-size: .88rem;
        font-weight: 600;
    }


    /* SUMMARY */

    .summary-card {
        height: 100%;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px;
        background: white;
        border: 1px solid #edf0f4;
        border-radius: 14px;
        box-shadow: 0 3px 12px rgba(15, 23, 42, .03);
    }


    .summary-icon {
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #eef4ff;
        color: #2563eb;
        font-size: 18px;
    }


        .summary-icon.review {
            background: #fff7ed;
            color: #ea580c;
        }


        .summary-icon.shortlisted {
            background: #fefce8;
            color: #ca8a04;
        }


    .summary-value {
        color: #1e293b;
        font-size: 1.35rem;
        font-weight: 700;
        line-height: 1.1;
    }


    .summary-label {
        margin-top: 3px;
        color: #64748b;
        font-size: .8rem;
    }

    /* APPLICATION CARD */

    .application-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }


    .application-card {
        display: flex;
        align-items: flex-start;
        gap: 17px;
        padding: 22px;
        background: white;
        border: 1px solid #e8edf3;
        border-radius: 15px;
        transition: .2s ease;
    }


        .application-card:hover {
            border-color: #d5deeb;
            box-shadow: 0 7px 22px rgba(15, 23, 42, .055);
        }


    .company-logo {
        width: 50px;
        height: 50px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: linear-gradient( 135deg, #eef4ff, #e5edff );
        color: #2563eb;
        font-size: .9rem;
        font-weight: 700;
    }


    .application-content {
        flex: 1;
        min-width: 0;
    }


    .job-title {
        color: #1e293b;
        font-size: 1.05rem;
        font-weight: 700;
    }


    .company-name {
        color: #64748b;
        font-size: .85rem;
    }


    .job-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        color: #64748b;
        font-size: .78rem;
    }


    /* STATUS */

    .status-badge {
        display: inline-flex;
        align-items: center;
        flex-shrink: 0;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: .75rem;
        font-weight: 600;
    }


    .status-submitted {
        background: #eef4ff;
        color: #2563eb;
    }


    .status-review {
        background: #fff7ed;
        color: #c2410c;
    }


    .status-shortlisted {
        background: #fefce8;
        color: #a16207;
    }


    .status-accepted {
        background: #ecfdf5;
        color: #047857;
    }


    .status-rejected {
        background: #fef2f2;
        color: #dc2626;
    }


    .status-withdrawn {
        background: #f1f5f9;
        color: #64748b;
    }


    /* APPLICATION DETAILS */

    .application-details {
        display: flex;
        flex-wrap: wrap;
        gap: 35px;
        margin-top: 16px;
        padding: 14px 0;
        border-top: 1px solid #edf0f4;
        border-bottom: 1px solid #edf0f4;
    }


    .detail-label {
        display: block;
        margin-bottom: 3px;
        color: #94a3b8;
        font-size: .7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .03em;
    }


    .detail-value {
        color: #475569;
        font-size: .82rem;
        font-weight: 500;
    }


    /* COVER MESSAGE */

    .cover-message {
        margin-top: 15px;
        padding: 13px 15px;
        border-radius: 10px;
        background: #f8fafc;
        border: 1px solid #edf0f4;
    }


    .cover-label {
        margin-bottom: 5px;
        color: #64748b;
        font-size: .75rem;
        font-weight: 600;
    }


    .cover-text {
        display: -webkit-box;
        overflow: hidden;
        color: #475569;
        font-size: .82rem;
        line-height: 1.55;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }


    /* ACTIONS */

    .application-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 16px;
    }


        .application-actions .btn {
            border-radius: 8px;
            padding: 6px 11px;
            font-size: .78rem;
            font-weight: 600;
        }


    .action-note {
        color: #64748b;
        font-size: .78rem;
    }


    .shortlisted-note {
        color: #a16207;
        font-weight: 600;
    }


    /* EMPTY */

    .empty-applications {
        padding: 65px 20px;
        text-align: center;
        background: white;
        border: 1px dashed #d8e0ea;
        border-radius: 16px;
    }


        .empty-applications p {
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }


    .empty-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        background: #eef4ff;
        color: #2563eb;
        font-size: 23px;
    }


    /* MOBILE */

    @@media (max-width: 767px) {

        .applications-header {
            align-items: flex-start;
            flex-direction: column;
        }


        .browse-button {
            width: 100%;
        }


        .application-card {
            padding: 18px;
        }


        .company-logo {
            width: 44px;
            height: 44px;
        }


        .application-details {
            gap: 18px;
        }


        .application-actions {
            align-items: stretch;
            flex-direction: column;
        }


            .application-actions .btn,
            .application-actions form,
            .application-actions form button {
                width: 100%;
            }
    }

</style>